# Environment variables for WeatherAPI
# ASP.NET Core reads these directly from the OS environment (or launchSettings.json).
# Use double-underscore (__) as the separator for nested config keys.
# Never commit secrets — add real values to launchSettings.json or your shell environment.

# CORS — allowed origins for the React client (optional)
# If unset, the API falls back to allowing any origin.
# Provide a JSON array of URLs, e.g.: ["http://localhost:3000"]
# Cors__AllowedOrigins=

# --- From Core (AboutTreeBuilder) ---
# These are set by CI/CD and are optional for local development.

# Integer build number stamped on the /about response
# BUILD_NUMBER=

# ISO 8601 UTC datetime of when the build started
# BUILD_START=
