# Copy this file to .env and fill in your values.
# Loaded at startup via DotNetEnv (Env.TraversePath().Load()).
# Never commit your actual .env — it is listed in .gitignore.

# Hosting (optional — launchSettings.json sets Development + http://localhost:8080)
# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://localhost:8080

# CORS — allowed origins for browser clients (optional)
# If unset, the API falls back to allowing any origin.
# Cors__AllowedOrigins__0=http://localhost:3000
# Cors__AllowedOrigins__1=http://localhost:8090

# WORKER_DOTNET_URL=http://localhost:8130
# MCP_SRV_APP_SERVICE_URL=http://localhost:8110
# MCP_SRV_FUNC_APP_URL=http://localhost:8120

# Hangfire storage (client only — the worker runs the servers) AND dbo.AgentActivity logging
# (chat prompts/responses, Current AI Weather). Hangfire falls back to in-memory storage when
# this is blank, but AgentActivityDbContext does not — this app will not start without it.
# Server/database only — no Authentication/User ID/Password. This app adds
# Authentication=Active Directory Default plus its own AZURE_CLIENT_ID at
# startup, so it authenticates via its managed identity, not a SQL login.
# DB_CONNECTION_STRING=

# Handler appends /openai/v1 when missing.
# AZURE_FOUNDRY_PROD_PROJ_URL=https://<foundry-account>.services.ai.azure.com/api/projects/wx1116-prod-proj
# AZURE_FOUNDRY_PROD_KEY=
# AZURE_FOUNDRY_PROD_MODEL=gpt-5.4-mini
# V5 hosted weather agent (GetCurrentAIWeatherV5Handler). Instructions, response schema, and
# MCP tools are configured on the agent itself - optional, defaults to wx1116-agent-for-current-weather.
# The agent's response schema must match AIWeatherResponse's camelCase fields and must not
# require runLogDetails (the handler has no local schema to strip it from, unlike V3/V4).
# Each MCP tool on the agent must use require_approval: never (Foundry portal: Agents →
# this agent → Tools → MCP → Approval = Never). V5 does not round-trip approvals.
# AZURE_FOUNDRY_PROD_CURRENT_WX_AGENT_NAME=wx1116-agent-for-current-weather
# Chat3 hosted agent (required for Chat3). Independent of V5's AZURE_FOUNDRY_PROD_CURRENT_WX_AGENT_NAME.
# AZURE_FOUNDRY_PROD_CHAT_AGENT_NAME=wx1116-agent-for-chat
# MCP_SRV_FUNC_APP_KEY=
# MCP_SRV_APP_SERVICE_KEY=

# BUILD_NUMBER=
# BUILD_START=
# BUILD_BRANCH_NAME=
