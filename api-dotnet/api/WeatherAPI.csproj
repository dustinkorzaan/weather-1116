<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Microsoft.Data.SqlClient (pulled in transitively via Core.csproj's
         Microsoft.EntityFrameworkCore.SqlServer, added for WX1116DbContext)
         needs ICU for connection setup, so invariant mode throws
         "Globalization Invariant Mode is not supported" from SqlConnection.Open,
         which crashed Database.Migrate() on startup. MVC and Worker never set
         this property, so they were unaffected. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
    <PackageReference Include="Hangfire.NetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
    <ProjectReference Include="..\..\cqmediator-dotnet\cqmediator\CQMediator.csproj" />
    <!-- Override Hangfire's vulnerable transitive Newtonsoft.Json (NU1903). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <ProjectReference Include="..\..\core-dotnet\core\Core.csproj" />
  </ItemGroup>

</Project>
