# worker-dotnet local settings (copy to .env; do not commit real values)

# Durable Hangfire storage connection string (Azure SQL / SQL Server).
# When set, Hangfire uses SQL Server storage; when blank, it falls back to
# in-memory storage so the worker still runs locally without a database.
# DB_CONNECTION_STRING=

# Hangfire About health thresholds (minutes).
# HangfireAboutHealth_StaleProcessingMinutes=30
# HangfireAboutHealth_StaleEnqueuedMinutes=60

# AI weather (ConfirmNashvilleAIWeather recurring job via GetCurrentAIWeatherHandler).
# Same settings as API/MVC — see docs/architecture.md.
# AZURE_FOUNDRY_PROD_EUS2_PROJ_URL=https://wx1116-prd-res-eu2.services.ai.azure.com/api/projects/wx1116-prd-prj-eu2
# AZURE_FOUNDRY_PROD_EUS2_KEY=
# AZURE_FOUNDRY_PROD_EUS2_MODEL=gpt-5.4-mini
# MCP_SRV_FUNC_APP_URL=http://localhost:8120
# MCP_SRV_FUNC_APP_KEY=
# MCP_SRV_APP_SERVICE_URL=http://localhost:8110
# MCP_SRV_APP_SERVICE_KEY=
