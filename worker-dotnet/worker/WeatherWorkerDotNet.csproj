<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WeatherWorkerDotNet</RootNamespace>
    <UserSecretsId>weather-worker-dotnet</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="../worker.tests/**" />
    <Content Remove="../worker.tests/**" />
    <None Remove="../worker.tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
    <PackageReference Include="Hangfire.NetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
    <ProjectReference Include="..\..\cqmediator-dotnet\cqmediator\CQMediator.csproj" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- Override Hangfire's vulnerable transitive Newtonsoft.Json (NU1903). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core-dotnet\core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WeatherWorkerDotNet.Tests" />
  </ItemGroup>

</Project>
