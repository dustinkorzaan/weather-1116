# Copy this file to .env and fill in your values.
# Loaded at startup via DotNetEnv (Env.TraversePath().Load()).
# Never commit your actual .env — it is listed in .gitignore.

# Azure AI Foundry project OpenAI endpoint (required)
# https://<account>.services.ai.azure.com/api/projects/wx1116-prod-centralus-proj/openai/v1
AZURE_FOUNDRY_PROD_CUS_PROJ_URL=
# Azure portal → your Azure AI Foundry / OpenAI resource → Keys and Endpoint.
AZURE_FOUNDRY_PROD_CUS_KEY=
