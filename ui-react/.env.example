# Copy this file to .env (or .env.local) and fill in your values.
# Vite loads these at dev/build start; only keys prefixed with VITE_ are exposed to the browser.
# Never commit your actual .env — it is listed in .gitignore.

# Weather API base URL (optional — Vite proxy defaults to http://localhost:8080)
# Used by the dev proxy and by client fetches / site links when set.
# VITE_API_DOTNET_URL=http://localhost:8080

# Cross-site navigation links (optional — defaults match local ports)
# VITE_UI_BLAZOR_URL=http://localhost:8090
# VITE_MVC_DOTNET_URL=http://localhost:8100
# VITE_WORKER_DOTNET_URL=http://localhost:8130

# Direct backend-wake pings only (optional — defaults match local ports).
# The UIs never call these MCP hosts directly; the wake screen pings them
# only to prewarm their containers in parallel with the other layers.
# VITE_MCP_SRV_APP_SERVICE_URL=http://localhost:8110
# VITE_MCP_SRV_FUNC_APP_URL=http://localhost:8120

# Google Maps JavaScript API key (optional — without it, the map shows a setup hint and a sample pin hover card)
# Enable "Maps JavaScript API" in Google Cloud Console, then paste the browser key.
# VITE_GOOGLE_MAPS_API_KEY=

# Application Insights connection string (optional — without it, the app runs with no browser telemetry)
# Same App Insights resource the .NET apps export to (infra/modules/monitoring.bicep output APP_INSIGHTS_CONNECTION_STRING).
# VITE_APPINSIGHTS_CONNECTION_STRING=

# VITE_BUILD_NUMBER=
# VITE_BUILD_START=
# VITE_BUILD_BRANCH_NAME=
