# Local React env — copy to .env.local and fill in values.
# Vite only exposes variables prefixed with VITE_.

# Weather API (optional; defaults to Vite proxy → localhost:8080)
# VITE_API_DOTNET_URL=http://localhost:8080

# Cross-site links (optional)
# VITE_UI_BLAZOR_URL=http://localhost:8090
# VITE_MVC_DOTNET_URL=http://localhost:8100

# Google Maps JavaScript API key (required for the city map)
# Enable "Maps JavaScript API" in Google Cloud Console, then paste the browser key here.
VITE_GOOGLE_MAPS_API_KEY=
