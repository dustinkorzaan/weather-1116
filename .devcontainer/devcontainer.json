{
    "name": ".NET in Codespaces",
    "image": "mcr.microsoft.com/dotnet/sdk:10.0",
    //   "image": "mcr.microsoft.com/devcontainers/universal:2",
    //   "waitFor": "onCreateCommand",
    //   "updateContentCommand": "cd ui-react && npm install",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "2"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        },
        "ghcr.io/devcontainers/features/powershell:1": {
            "version": "latest"
        },
        "ghcr.io/azure/azure-dev/azd:0": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/common-utils:2": {},
        "ghcr.io/devcontainers/features/dotnet:2": {
            "version": "none",
            "dotnetRuntimeVersions": "10.0",
            "aspNetCoreRuntimeVersions": "10.0"
        }
    },
    "customizations": {
        "codespaces": {
            "openFiles": []
        },
        "vscode": {
            "extensions": [
                "ms-vscode.vscode-node-azure-pack",
                "GitHub.copilot",
                "GitHub.vscode-github-actions",
                "ms-dotnettools.csdevkit"
            ]
        }
    },
    "forwardPorts": [
        3000,
        8080,
        8090,
        8100
    ],
    "postCreateCommand": "bash -lc 'dotnet dev-certs https && dotnet new install Aspire.ProjectTemplates && dotnet restore && cd ui-react && npm ci'",
    // "hostRequirements": {
    //     "memory": "8gb",
    //     "cpus": 4
    // },
    // "postAttachCommand": {
    //     "server": "cd ui-react && npm start"
    // },
    "remoteEnv": {
        "DOTNET_MULTILEVEL_LOOKUP": "0",
        "TARGET": "net10.0"
    },
    "portsAttributes": {
        "3000": {
            "label": "React App",
            "onAutoForward": "silent"
        },
        "8080": {
            "label": "Weather API",
            "onAutoForward": "silent"
        },
        "8090": {
            "label": "Weather Blazor",
            "onAutoForward": "silent"
        },
        "8100": {
            "label": "Weather MVC",
            "onAutoForward": "silent"
        }
    }
}
