@inherits LayoutComponentBase
@using WeatherBlazor.Data
@inject WeatherForecastClient WeatherClient
@inject IConfiguration Configuration

<PageTitle>Weather Razor</PageTitle>

@{
    var uiReactUrl = Configuration["UI_REACT_URL"] ?? "http://localhost:3000";
    var mvcUrl = Configuration["MVC_URL"] ?? "http://localhost:8100";
    var apiUrl = (Configuration["API_DOTNET_URL"] ?? "http://localhost:8080").TrimEnd('/');
    var apiAboutUrl = $"{apiUrl}/About";
}

<div class="page">
    <header class="top-row">
        <NavLink class="site-brand" href="" Match="NavLinkMatch.All">
            <img src="logo.svg" alt="Weather logo" class="site-logo" />
            <span>Weather Blazor</span>
        </NavLink>

        <div class="avatar-menu" @onclick:stopPropagation="true">
            <button type="button"
                    class="avatar-button"
                    aria-haspopup="true"
                    aria-expanded="@_isMenuOpen.ToString().ToLowerInvariant()"
                    aria-label="Open user menu"
                    @onclick="ToggleMenu">
                <svg viewBox="0 0 24 24" class="avatar-icon" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="8" r="4" fill="currentColor" />
                    <path d="M4 20c0-4.418 3.582-8 8-8s8 3.582 8 8" fill="currentColor" />
                </svg>
            </button>

            @if (_isMenuOpen)
            {
                <div class="avatar-dropdown-backdrop" role="presentation" @onclick="CloseMenu"></div>
                <ul class="avatar-dropdown" role="menu">
                    <li role="none">
                        <a class="avatar-dropdown-item" role="menuitem" href="@uiReactUrl" target="_blank" rel="noopener noreferrer">UI React</a>
                    </li>
                    <li role="none">
                        <a class="avatar-dropdown-item" role="menuitem" href="@mvcUrl" target="_blank" rel="noopener noreferrer">MVC</a>
                    </li>
                    <li role="none">
                        <a class="avatar-dropdown-item" role="menuitem" href="@apiAboutUrl" target="_blank" rel="noopener noreferrer">API About</a>
                    </li>
                    <li role="separator" class="avatar-dropdown-divider"></li>
                    <li role="none">
                        <button type="button" role="menuitem" class="avatar-dropdown-item" @onclick="OpenAboutModal">
                            About
                        </button>
                    </li>
                </ul>
            }
        </div>
    </header>

    <main>
        <article class="content px-4">
            <div class="content-inner">
                @Body
            </div>
        </article>
    </main>
</div>

@if (_isAboutModalOpen)
{
    <div class="modal-backdrop" role="presentation" @onclick="CloseAboutModal">
        <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="about-modal-title" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 id="about-modal-title" class="modal-title">About</h2>
                <button type="button" class="modal-close" aria-label="Close" @onclick="CloseAboutModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (_isAboutLoading)
                {
                    <p class="about-status loading">
                        <span class="about-spinner" aria-hidden="true"></span>
                        <span>Loading About information...</span>
                    </p>
                }
                else if (!string.IsNullOrWhiteSpace(_aboutError))
                {
                    <p class="about-status error">@_aboutError</p>
                }
                else if (_aboutRoot is not null)
                {
                    <ul class="about-tree-list root">
                        <AboutTreeNode Node="_aboutRoot" />
                    </ul>
                }
                <div class="site-links-footer">
                    <a href="@uiReactUrl" target="_blank" rel="noopener noreferrer">UI React</a>
                    <a href="@mvcUrl" target="_blank" rel="noopener noreferrer">MVC</a>
                    <a href="@apiAboutUrl" target="_blank" rel="noopener noreferrer">API About</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isMenuOpen;
    private bool _isAboutModalOpen;
    private bool _isAboutLoading;
    private string _aboutError = string.Empty;
    private AboutNode? _aboutRoot;

    private void ToggleMenu()
    {
        _isMenuOpen = !_isMenuOpen;
    }

    private void CloseMenu()
    {
        _isMenuOpen = false;
    }

    private async Task OpenAboutModal()
    {
        _isMenuOpen = false;
        _isAboutModalOpen = true;
        _isAboutLoading = true;
        _aboutError = string.Empty;

        try
        {
            _aboutRoot = await WeatherClient.GetAboutAsync();
            if (_aboutRoot is null)
            {
                _aboutError = "Unable to load About information.";
            }
        }
        catch
        {
            _aboutRoot = null;
            _aboutError = "Unable to load About information.";
        }
        finally
        {
            _isAboutLoading = false;
        }
    }

    private void CloseAboutModal()
    {
        _isAboutModalOpen = false;
    }
}
