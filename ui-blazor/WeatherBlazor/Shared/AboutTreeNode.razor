@using WeatherBlazor.Data

@if (Node is not null)
{
    <li class="about-tree-item">
        <div class="about-tree-row">
            <span class="about-tree-name">@(Node.Name ?? "Unnamed node")</span>
            <span class="about-tree-health @(Node.IsHealthy ? "healthy" : "unhealthy")">
                @(Node.IsHealthy ? "Healthy" : "Unhealthy")
            </span>
        </div>
        @if (Node.BuildNumber.HasValue || Node.BuildStart.HasValue)
        {
            <div class="about-tree-meta">
                @if (Node.BuildNumber.HasValue)
                {
                    <span>Build #@Node.BuildNumber</span>
                }
                @if (Node.BuildStart.HasValue)
                {
                    @if (Node.BuildNumber.HasValue)
                    {
                        <span> | </span>
                    }
                    <span>Started @Node.BuildStart.Value.ToString("u")</span>
                }
            </div>
        }

        @if (Node.Children.Count > 0)
        {
            <ul class="about-tree-list">
                @foreach (var child in Node.Children)
                {
                    <AboutTreeNode Node="child" />
                }
            </ul>
        }
    </li>
}

@code {
    [Parameter, EditorRequired]
    public AboutNode? Node { get; set; }
}
