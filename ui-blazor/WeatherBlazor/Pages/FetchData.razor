@page "/"
@using WeatherBlazor.Data
@inject WeatherForecastClient ForecastClient
@inject IConfiguration Configuration

<PageTitle>Weather Razor</PageTitle>

<h1>Weather forecast</h1>

<p><strong>@helloMessage</strong></p>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}

<WeatherMap />

@if (currentWeather is not null)
{
    <section class="current-weather-section" aria-label="Current weather">
        <h2>Current conditions — @currentWeather.Location</h2>
        <dl class="current-weather-details">
            <dt>Temperature</dt>
            <dd>@((currentWeather.TemperatureC).ToString("0.##")) °C / @((currentWeather.TemperatureC * 9.0 / 5.0 + 32.0).ToString("0.##")) °F</dd>
            <dt>Wind</dt>
            <dd>@(currentWeather.WindSpeedKph.ToString("0.#")) km/h at @(currentWeather.WindDirectionDeg)°</dd>
            <dt>Observed at</dt>
            <dd>@currentWeather.ObservedAt</dd>
        </dl>
    </section>
}

@if (forecasts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Temp. (C)</th>
                    <th>Temp. (F)</th>
                    <th>Summary</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var forecast in forecasts)
                {
                    <tr>
                        <td>@forecast.Date.ToShortDateString()</td>
                        <td>@((forecast.TemperatureK - 273.15).ToString("0.##"))</td>
                        <td>@((((forecast.TemperatureK - 273.15) * 9.0 / 5.0) + 32.0).ToString("0.##"))</td>
                        <td>@forecast.Summary</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private WeatherForecast[]? forecasts;
    private CurrentWeatherConditions? currentWeather;
    private string helloMessage = "Loading hello message...";
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var helloResponse = await ForecastClient.GetHelloAsync();
            helloMessage = helloResponse?.RequestResponse ?? "No hello response returned.";
        }
        catch
        {
            helloMessage = "Unable to load hello message from API.";
            errorMessage ??= "Unable to load data from the weather API.";
        }

        try
        {
            var defaultLocation = Configuration["CurrentWeather:DefaultLocation"] ?? "New York, NY";
            currentWeather = await ForecastClient.GetCurrentWeatherAsync(defaultLocation);
        }
        catch
        {
            // Non-fatal: current weather is best-effort.
        }

        try
        {
            forecasts = await ForecastClient.GetForecastAsync(DateTime.Now);
        }
        catch
        {
            forecasts = [];
            errorMessage ??= "Unable to load data from the weather API.";
        }
    }
}
