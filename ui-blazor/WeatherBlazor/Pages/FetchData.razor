@page "/"
@using WeatherBlazor.Data
@inject WeatherForecastClient ForecastClient

<PageTitle>Weather Razor</PageTitle>

<h1>Weather forecast</h1>

<p><strong>@helloMessage</strong></p>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}

<section class="ai-weather-section" aria-label="Current AI weather">
    <form class="ai-weather-form" @onsubmit="GetCurrentAIWeatherAsync" @onsubmit:preventDefault>
        <label class="ai-weather-label" for="ai-weather-location">Location:</label>
        <input id="ai-weather-location"
               class="form-control ai-weather-input"
               type="text"
               @bind="location"
               disabled="@isAiWeatherLoading"
               autocomplete="address-level2" />
        <button type="submit"
                class="btn btn-primary ai-weather-button"
                disabled="@isAiWeatherLoading"
                aria-busy="@isAiWeatherLoading.ToString().ToLowerInvariant()">
            @if (isAiWeatherLoading)
            {
                <span class="ai-weather-spinner" aria-hidden="true"></span>
            }
            <span>Get Current AI Weather</span>
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(aiWeatherError))
    {
        <p class="text-danger">@aiWeatherError</p>
    }

    @if (isAiWeatherLoading && !string.IsNullOrWhiteSpace(aiWeatherStatus))
    {
        <p class="ai-weather-status" aria-live="polite">@aiWeatherStatus</p>
    }

    @if (isAiWeatherLoading && !string.IsNullOrWhiteSpace(aiWeatherStreamPreview))
    {
        <pre class="ai-weather-stream-preview" aria-live="polite">@aiWeatherStreamPreview</pre>
    }

    @if (aiWeather is not null && !isAiWeatherLoading)
    {
        <div class="ai-weather-results">
            <p class="ai-weather-summary">@aiWeather.FullSummary</p>
            <dl class="ai-weather-stats">
                <div class="ai-weather-stat">
                    <dt>Temperature F</dt>
                    <dd>@aiWeather.TemperatureF</dd>
                </div>
                <div class="ai-weather-stat">
                    <dt>Wind Speed MPH</dt>
                    <dd>@aiWeather.WindSpeedMPH</dd>
                </div>
                <div class="ai-weather-stat">
                    <dt>Wind Direction</dt>
                    <dd>@aiWeather.WindDirection</dd>
                </div>
                <div class="ai-weather-stat">
                    <dt>Conditions</dt>
                    <dd>@aiWeather.Conditions</dd>
                </div>
            </dl>
        </div>
    }
</section>

<WeatherMap />

@if (forecasts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Temp. (C)</th>
                    <th>Temp. (F)</th>
                    <th>Summary</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var forecast in forecasts)
                {
                    <tr>
                        <td>@forecast.Date.ToShortDateString()</td>
                        <td>@((forecast.TemperatureK - 273.15).ToString("0.##"))</td>
                        <td>@((((forecast.TemperatureK - 273.15) * 9.0 / 5.0) + 32.0).ToString("0.##"))</td>
                        <td>@forecast.Summary</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private WeatherForecast[]? forecasts;
    private string helloMessage = "Loading hello message...";
    private string? errorMessage;
    private string location = "Nashville, TN";
    private bool isAiWeatherLoading;
    private string? aiWeatherError;
    private string? aiWeatherStatus;
    private string aiWeatherStreamPreview = string.Empty;
    private AIWeatherResponse? aiWeather;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var helloResponse = await ForecastClient.GetHelloAsync();
            helloMessage = helloResponse?.RequestResponse ?? "No hello response returned.";
        }
        catch
        {
            helloMessage = "Unable to load hello message from API.";
            errorMessage ??= "Unable to load data from the weather API.";
        }

        try
        {
            forecasts = await ForecastClient.GetForecastAsync(DateTime.Now);
        }
        catch
        {
            forecasts = [];
            errorMessage ??= "Unable to load data from the weather API.";
        }
    }

    private async Task GetCurrentAIWeatherAsync()
    {
        isAiWeatherLoading = true;
        aiWeatherError = null;
        aiWeatherStatus = "Starting AI weather request...";
        aiWeatherStreamPreview = string.Empty;
        aiWeather = null;

        try
        {
            var trimmed = string.IsNullOrWhiteSpace(location) ? "Nashville, TN" : location.Trim();
            location = trimmed;

            await ForecastClient.StreamCurrentAIWeatherAsync(trimmed, update =>
            {
                if (update.Type == "status" && !string.IsNullOrWhiteSpace(update.Message))
                {
                    aiWeatherStatus = update.Message;
                }

                if (update.Type == "textDelta" && !string.IsNullOrWhiteSpace(update.Delta))
                {
                    aiWeatherStreamPreview += update.Delta;
                }

                if (update.Type == "complete" && update.Result is not null)
                {
                    aiWeather = update.Result;
                    aiWeatherStatus = null;
                    aiWeatherStreamPreview = string.Empty;
                }

                InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
            aiWeather = null;
            aiWeatherError = "Unable to load AI weather.";
            aiWeatherStatus = null;
            aiWeatherStreamPreview = string.Empty;
        }
        finally
        {
            isAiWeatherLoading = false;
        }
    }
}
