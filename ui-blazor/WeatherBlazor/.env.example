# Copy this file to .env and fill in your values.
# Loaded at startup via DotNetEnv (Env.TraversePath().Load()).
# ASP.NET Core nested keys use double-underscore (__).
# Never commit your actual .env — it is listed in .gitignore.

# Hosting (optional — launchSettings.json sets Development + http://localhost:8090)
# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://localhost:8090

# Weather API base URL (required — appsettings.json defaults to http://localhost:8080)
# API_DOTNET_URL=http://localhost:8080

# Google Maps JavaScript API key (optional — map shows a setup hint when blank)
# Enable "Maps JavaScript API" in Google Cloud Console, then paste the browser key.
# GoogleMaps__ApiKey=

# Cross-site navigation links (optional — defaults match local ports)
# SiteLinks__UiReact=http://localhost:3000
# SiteLinks__UiBlazor=http://localhost:8090
# SiteLinks__Mvc=http://localhost:8100
# SiteLinks__ApiDotNet=http://localhost:8080

# Build metadata shown on About (optional — set by CI/CD)
# BUILD_NUMBER=
# BUILD_START=
