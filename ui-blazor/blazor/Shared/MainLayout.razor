@inherits LayoutComponentBase
@implements IDisposable
@using WeatherBlazor.Data
@inject WeatherApiClient WeatherClient
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IThemeService ThemeService

<PageTitle>Weather Razor</PageTitle>
@* Fluent UI v5 removed FluentHeader/FluentBodyContent and rebuilt FluentLayout as a grid of
   FluentLayoutItem areas; plain elements keep the v4 class names the shell CSS (site.css) targets. *@
<div class="layout weather-shell">
    <header class="header weather-header">
        <a href="/" class="brand-link">
            <img src="logo.svg" alt="Weather logo" width="24" height="24" class="brand-logo" />
            <h1 class="brand-title">Weather Blazor</h1>
        </a>

        <FluentSpacer />

        <div class="header-actions">
            @if (IsMapPage)
            {
            <div class="add-location-wrap">
                <button type="button"
                        class="add-location-button"
                        title="Add location"
                        aria-label="Add location"
                        aria-expanded="@_addLocationOpen.ToString().ToLowerInvariant()"
                        aria-controls="add-location-panel"
                        @onclick="ToggleAddLocation">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14" />
                        <path d="M5 12h14" />
                    </svg>
                </button>
                @if (_addLocationOpen)
                {
                    <div class="add-location-backdrop" @onclick="CloseAddLocation"></div>
                    <form id="add-location-panel"
                          class="add-location-panel"
                          @onsubmit="SubmitAddLocationAsync"
                          @onsubmit:preventDefault="true">
                        <label class="add-location-label" for="add-location-input">Location</label>
                        <input id="add-location-input"
                               class="add-location-input"
                               type="text"
                               value="@_addLocation"
                               disabled="@_addLocationLoading"
                               autocomplete="address-level2"
                               placeholder="Nashville, TN"
                               @oninput="OnAddLocationInput" />
                        <button type="submit" class="add-location-submit" disabled="@_addLocationLoading">
                            @if (_addLocationLoading)
                            {
                                <span class="add-location-spinner" aria-hidden="true"></span>
                            }
                            @(_addLocationLoading ? "Looking up location…" : "Add to map")
                        </button>
                        @if (!string.IsNullOrWhiteSpace(_addLocationError))
                        {
                            <p class="add-location-error">@_addLocationError</p>
                        }
                    </form>
                }
            </div>

            @* The Chat5a sidebar exists to edit saved cities next to their pins, so like
               Add location it is offered on the map page only. *@
            <button type="button"
                    class="chat-toggle-button"
                    title="Open chat"
                    aria-label="Open chat"
                    aria-expanded="@_chatOpen.ToString().ToLowerInvariant()"
                    aria-controls="chat5a-sidebar"
                    @onclick="ToggleChat">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
            </button>
            }

        <button id="user-menu-button"
                type="button"
                class="avatar-button"
                title="Open user menu"
                aria-label="Open user menu">
            <img src="avatar.svg" alt="" width="20" height="20" class="avatar-icon" />
        </button>
        @* Fluent v5's <fluent-menu> pops up its first child, so the items need a FluentMenuList
           wrapper; without it only "Home" became the popover and the rest stayed on screen. *@
        <FluentMenu Trigger="user-menu-button">
            <FluentMenuList>
            <FluentMenuItem Label="Home" OnClick="@(() => NavigateTo("/"))" />
            <FluentDivider />
            <FluentMenuItem Label="Hello World" OnClick="@(() => NavigateTo("/hello-world"))" />
            <FluentMenuItem Label="Current AI Weather" OnClick="@(() => NavigateTo("/current-ai-weather"))" />
            <FluentMenuItem Label="Chat Clients" OnClick="@(() => NavigateTo("/chat-clients"))" />
            <FluentDivider />
            <FluentMenuItem Label="@ThemeItemLabel("light", "Light")" OnClick="@(() => SetThemeAsync("light"))" />
            <FluentMenuItem Label="@ThemeItemLabel("dark", "Dark")" OnClick="@(() => SetThemeAsync("dark"))" />
            <FluentMenuItem Label="@ThemeItemLabel("system", "System")" OnClick="@(() => SetThemeAsync("system"))" />
            <FluentDivider />
            <FluentMenuItem Label="About" OnClick="OpenAboutModal" />
            </FluentMenuList>
        </FluentMenu>
        </div>
    </header>

    <main class="body-content weather-body">
        @* On / the page and the Chat5a sidebar share one flex row (sidebar docked right, the map
           narrows; stacked under the map below 640px). Elsewhere both wrappers are display:
           contents and the sidebar stays mounted but hidden, so its history survives navigation. *@
        <div class="weather-main @(IsMapPage ? "is-map-page" : null)">
            <div class="weather-main-page">
                @Body
            </div>
            <Chat5aSidebar Open="ChatVisible" OnClose="CloseChat" />
        </div>
    </main>
</div>

<div class="about-modal @(_aboutDialogHidden ? null : "is-open")"
     role="presentation"
     @onclick="CloseAboutModal">
    <div class="about-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="about-dialog-title"
         @onclick:stopPropagation="true">
        <div class="about-dialog-header">
            <h2 id="about-dialog-title" class="about-dialog-title">About</h2>
            <button type="button" class="about-close" aria-label="Close" @onclick="CloseAboutModal">&times;</button>
        </div>
        <div class="about-dialog-body">
            @if (_isAboutLoading)
            {
                <div class="inline-row">
                    <FluentSpinner Size="SpinnerSize.ExtraSmall" />
                    <span>Loading About information...</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_aboutError))
            {
                <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@_aboutError</FluentMessageBar>
            }
            else if (_aboutRoot is not null)
            {
                <ul class="about-tree-list root">
                    <AboutTreeNode Node="_aboutRoot" />
                </ul>
            }

            <FluentDivider Style="margin: 1rem 0;" />

            <div class="footer-links">
                <FluentLink Href="@_uiReactUrl" Target="LinkTarget.Blank">UI React</FluentLink>
                <FluentLink Href="@_mvcUrl" Target="LinkTarget.Blank">MVC</FluentLink>
                <FluentLink Href="@_apiAboutUrl" Target="LinkTarget.Blank">API About</FluentLink>
                <FluentLink Href="@_workerHangfireUrl" Target="LinkTarget.Blank">Worker Hangfire</FluentLink>
                <FluentLink Href="@_mcpSrvAppServiceAboutUrl" Target="LinkTarget.Blank">MCP App Service About</FluentLink>
                <FluentLink Href="@_mcpSrvFuncAppAboutUrl" Target="LinkTarget.Blank">MCP Func App About</FluentLink>
                <FluentLink Href="@_mcpSrvPythonAboutUrl" Target="LinkTarget.Blank">MCP Python About</FluentLink>
                <FluentLink Href="@_mcpSrvNodeAboutUrl" Target="LinkTarget.Blank">MCP Node About</FluentLink>
                <FluentLink Href="https://github.com/dustinkorzaan/weather-1116" Target="LinkTarget.Blank">GitHub</FluentLink>
            </div>
        </div>
    </div>
</div>

<FluentProviders />

@code {
    private string _uiReactUrl = "http://localhost:3000";
    private string _mvcUrl = "http://localhost:8100";
    private string _apiAboutUrl = "http://localhost:8080/About";
    private string _workerHangfireUrl = "http://localhost:8130/hangfire";
    private string _mcpSrvAppServiceAboutUrl = "http://localhost:8110/About";
    private string _mcpSrvFuncAppAboutUrl = "http://localhost:8120/about";
    private string _mcpSrvPythonAboutUrl = "http://localhost:8140/About";
    private string _mcpSrvNodeAboutUrl = "http://localhost:8150/About";

    private bool _aboutDialogHidden = true;
    private bool _isAboutLoading;
    private string _aboutError = string.Empty;
    private AboutNode? _aboutRoot;
    private string _themePreference = "system";
    private bool _addLocationOpen;
    private bool _addLocationLoading;
    private string _addLocation = "Nashville, TN";
    private string _addLocationError = string.Empty;
    private bool _chatOpen;

    private ThemeMode FluentMode => _themePreference switch
    {
        "light" => ThemeMode.Light,
        "dark" => ThemeMode.Dark,
        _ => ThemeMode.System,
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _uiReactUrl = Configuration["UI_REACT_URL"] ?? "http://localhost:3000";
        _mvcUrl = Configuration["MVC_URL"] ?? "http://localhost:8100";
        var apiUrl = (Configuration["API_DOTNET_URL"] ?? "http://localhost:8080").TrimEnd('/');
        _apiAboutUrl = $"{apiUrl}/About";
        var workerUrl = (Configuration["WORKER_DOTNET_URL"] ?? "http://localhost:8130").TrimEnd('/');
        _workerHangfireUrl = $"{workerUrl}/hangfire";
        var mcpSrvAppServiceUrl = (Configuration["MCP_SRV_APP_SERVICE_URL"] ?? "http://localhost:8110").TrimEnd('/');
        _mcpSrvAppServiceAboutUrl = $"{mcpSrvAppServiceUrl}/About";
        var mcpSrvFuncAppUrl = (Configuration["MCP_SRV_FUNC_APP_URL"] ?? "http://localhost:8120").TrimEnd('/');
        _mcpSrvFuncAppAboutUrl = $"{mcpSrvFuncAppUrl}/about";
        var mcpSrvPythonUrl = (Configuration["MCP_SRV_PYTHON_URL"] ?? "http://localhost:8140").TrimEnd('/');
        _mcpSrvPythonAboutUrl = $"{mcpSrvPythonUrl}/About";
        var mcpSrvNodeUrl = (Configuration["MCP_SRV_NODE_URL"] ?? "http://localhost:8150").TrimEnd('/');
        _mcpSrvNodeAboutUrl = $"{mcpSrvNodeUrl}/About";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var stored = await JS.InvokeAsync<string>("weatherTheme.getPreference");
            if (!string.IsNullOrWhiteSpace(stored) && stored != _themePreference)
            {
                _themePreference = stored;
                StateHasChanged();
            }
        }
        catch
        {
            // Tests and missing script keep System.
        }

        await ApplyFluentThemeAsync();
    }

    // Twilight indigo: Fluent derives its brand ramp (primary buttons, selected tabs, focus) from it.
    private const string BrandColor = "#4b4fb5";

    private async Task ApplyFluentThemeAsync()
    {
        try
        {
            await ThemeService.SetThemeAsync(new ThemeSettings(BrandColor, 0, 0, FluentMode, false));
        }
        catch
        {
            // Fluent's theme module is unavailable in component tests.
        }
    }

    private bool IsMapPage
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            var separator = path.IndexOfAny(['?', '#']);
            if (separator >= 0)
            {
                path = path[..separator];
            }

            return string.IsNullOrEmpty(path);
        }
    }

    private bool ChatVisible => _chatOpen && IsMapPage;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_addLocationOpen && !IsMapPage)
        {
            _addLocationOpen = false;
            _addLocationError = string.Empty;
        }

        if (!IsMapPage)
        {
            _chatOpen = false;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private string ThemeItemLabel(string value, string label) =>
        string.Equals(_themePreference, value, StringComparison.Ordinal)
            ? $"{label} ✓"
            : label;

    private async Task SetThemeAsync(string preference)
    {
        _themePreference = preference;
        try
        {
            await JS.InvokeVoidAsync("weatherTheme.setPreference", preference);
        }
        catch
        {
            // Theme script is optional in component tests.
        }

        await ApplyFluentThemeAsync();
    }

    private void NavigateTo(string path)
    {
        Navigation.NavigateTo(path);
    }

    private async Task OpenAboutModal()
    {
        _aboutDialogHidden = false;
        _isAboutLoading = true;
        _aboutError = string.Empty;

        try
        {
            _aboutRoot = await WeatherClient.GetAbout();
            if (_aboutRoot is null)
            {
                _aboutError = "Unable to load About information.";
            }
        }
        catch
        {
            _aboutRoot = null;
            _aboutError = "Unable to load About information.";
        }
        finally
        {
            _isAboutLoading = false;
        }
    }

    private void CloseAboutModal()
    {
        _aboutDialogHidden = true;
    }

    private void ToggleAddLocation()
    {
        if (_addLocationLoading)
        {
            _addLocationOpen = true;
            return;
        }

        _addLocationOpen = !_addLocationOpen;
        _addLocationError = string.Empty;
    }

    private void CloseAddLocation()
    {
        if (_addLocationLoading)
        {
            return;
        }

        _addLocationOpen = false;
    }

    private void ToggleChat()
    {
        _chatOpen = !_chatOpen;
    }

    private void CloseChat()
    {
        _chatOpen = false;
    }

    private void OnAddLocationInput(ChangeEventArgs args)
    {
        _addLocation = args.Value?.ToString() ?? string.Empty;
    }

    private async Task SubmitAddLocationAsync()
    {
        var trimmed = string.IsNullOrWhiteSpace(_addLocation) ? "Nashville, TN" : _addLocation.Trim();
        _addLocation = trimmed;
        _addLocationLoading = true;
        _addLocationError = string.Empty;

        try
        {
            var match = await WeatherClient.SearchLocation(trimmed);
            if (match is null || (match.Latitude == 0 && match.Longitude == 0))
            {
                _addLocationError = "Unable to find that location.";
                return;
            }

            var nameParts = new[] { match.Name, match.State }
                .Where(part => !string.IsNullOrWhiteSpace(part));
            var name = string.Join(", ", nameParts);
            if (string.IsNullOrWhiteSpace(name))
            {
                name = trimmed;
            }

            var city = new
            {
                id = Guid.NewGuid().ToString(),
                name,
                lat = match.Latitude,
                lng = match.Longitude,
            };

            await JS.InvokeVoidAsync("weatherMap.addCity", city);
            _addLocationOpen = false;
            _addLocation = "Nashville, TN";
        }
        catch
        {
            _addLocationError = "Unable to find that location.";
        }
        finally
        {
            _addLocationLoading = false;
        }
    }
}
