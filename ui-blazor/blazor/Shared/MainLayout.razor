@inherits LayoutComponentBase
@using WeatherBlazor.Data
@inject WeatherApiClient WeatherClient
@inject IConfiguration Configuration

<PageTitle>Weather Razor</PageTitle>
<FluentDesignTheme CustomColor="#6b7280" Mode="DesignThemeModes.Light" />

@{
    var uiReactUrl = Configuration["UI_REACT_URL"] ?? "http://localhost:3000";
    var mvcUrl = Configuration["MVC_URL"] ?? "http://localhost:8100";
    var apiUrl = (Configuration["API_DOTNET_URL"] ?? "http://localhost:8080").TrimEnd('/');
    var apiAboutUrl = $"{apiUrl}/About";
    var workerUrl = (Configuration["WORKER_DOTNET_URL"] ?? "http://localhost:8130").TrimEnd('/');
    var workerHangfireUrl = $"{workerUrl}/hangfire";
}

<FluentLayout Class="weather-shell">
    <FluentHeader Height="53" Class="weather-header">
        <a href="/" class="brand-link">
            <img src="logo.svg" alt="Weather logo" width="24" height="24" class="brand-logo" />
            <h1 class="brand-title">Weather Blazor</h1>
        </a>

        <FluentSpacer />

        <FluentButton Id="user-menu-button"
                      Appearance="Appearance.Stealth"
                      Class="avatar-button"
                      Title="Open user menu"
                      aria-label="Open user menu">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true" focusable="false">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
        </FluentButton>
        <FluentMenu Anchor="user-menu-button"
                    Trigger="MouseButton.Left"
                    HorizontalPosition="HorizontalPosition.Right">
            <FluentMenuItem>
                <a href="@uiReactUrl" target="_blank" rel="noopener noreferrer">UI React</a>
            </FluentMenuItem>
            <FluentMenuItem>
                <a href="@mvcUrl" target="_blank" rel="noopener noreferrer">MVC</a>
            </FluentMenuItem>
            <FluentMenuItem>
                <a href="@apiAboutUrl" target="_blank" rel="noopener noreferrer">API About</a>
            </FluentMenuItem>
            <FluentMenuItem>
                <a href="@workerHangfireUrl" target="_blank" rel="noopener noreferrer">Worker Hangfire</a>
            </FluentMenuItem>
            <FluentDivider />
            <FluentMenuItem>
                <a href="/presentation">Presentation</a>
            </FluentMenuItem>
            <FluentDivider />
            <FluentMenuItem OnClick="OpenAboutModal">About</FluentMenuItem>
        </FluentMenu>
    </FluentHeader>

    <FluentBodyContent Class="weather-body">
        @Body
    </FluentBodyContent>
</FluentLayout>

<FluentDialog @bind-Hidden="_aboutDialogHidden"
              Modal="true"
              TrapFocus="true"
              AriaLabel="About"
              Style="width: min(42rem, calc(100vw - 2rem));">
    <FluentDialogHeader>
        <FluentLabel Typo="Typography.PaneHeader">About</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        @if (_isAboutLoading)
        {
            <div class="inline-row">
                <FluentProgressRing Width="20px" Stroke="ProgressStroke.Small" />
                <span>Loading About information...</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_aboutError))
        {
            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@_aboutError</FluentMessageBar>
        }
        else if (_aboutRoot is not null)
        {
            <ul class="about-tree-list root">
                <AboutTreeNode Node="_aboutRoot" />
            </ul>
        }

        <FluentDivider Style="margin: 1rem 0;" />

        <div class="footer-links">
            <FluentAnchor Href="@uiReactUrl" Target="_blank" Rel="noopener noreferrer" Appearance="Appearance.Hypertext">UI React</FluentAnchor>
            <FluentAnchor Href="@mvcUrl" Target="_blank" Rel="noopener noreferrer" Appearance="Appearance.Hypertext">MVC</FluentAnchor>
            <FluentAnchor Href="@apiAboutUrl" Target="_blank" Rel="noopener noreferrer" Appearance="Appearance.Hypertext">API About</FluentAnchor>
            <FluentAnchor Href="@workerHangfireUrl" Target="_blank" Rel="noopener noreferrer" Appearance="Appearance.Hypertext">Worker Hangfire</FluentAnchor>
            <FluentAnchor Href="https://github.com/dustinkorzaan/weather-1116" Target="_blank" Rel="noopener noreferrer" Appearance="Appearance.Hypertext">GitHub</FluentAnchor>
        </div>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Outline" OnClick="CloseAboutModal">Close</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<FluentDialogProvider />
<FluentMenuProvider />

@code {
    private bool _aboutDialogHidden = true;
    private bool _isAboutLoading;
    private string _aboutError = string.Empty;
    private AboutNode? _aboutRoot;

    private async Task OpenAboutModal()
    {
        _aboutDialogHidden = false;
        _isAboutLoading = true;
        _aboutError = string.Empty;

        try
        {
            _aboutRoot = await WeatherClient.GetAbout();
            if (_aboutRoot is null)
            {
                _aboutError = "Unable to load About information.";
            }
        }
        catch
        {
            _aboutRoot = null;
            _aboutError = "Unable to load About information.";
        }
        finally
        {
            _isAboutLoading = false;
        }
    }

    private void CloseAboutModal()
    {
        _aboutDialogHidden = true;
    }
}
