@inherits LayoutComponentBase
@using WeatherBlazor.Data
@inject WeatherApiClient WeatherClient
@inject IConfiguration Configuration

<PageTitle>Weather Razor</PageTitle>

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@{
    var uiReactUrl = Configuration["UI_REACT_URL"] ?? "http://localhost:3000";
    var mvcUrl = Configuration["MVC_URL"] ?? "http://localhost:8100";
    var apiUrl = (Configuration["API_DOTNET_URL"] ?? "http://localhost:8080").TrimEnd('/');
    var apiAboutUrl = $"{apiUrl}/About";
    var workerUrl = (Configuration["WORKER_DOTNET_URL"] ?? "http://localhost:8130").TrimEnd('/');
    var workerHangfireUrl = $"{workerUrl}/hangfire";
}

<MudLayout>
    <MudAppBar Color="Color.Surface" Elevation="1" Dense="true">
        <MudLink Href="" Underline="Underline.None" Class="d-flex align-center gap-2 mud-inherit-text">
            <img src="logo.svg" alt="Weather logo" width="22" height="22" />
            <MudText Typo="Typo.h6" Class="text-truncate">Weather Blazor</MudText>
        </MudLink>

        <MudSpacer />

        <MudMenu Icon="@Icons.Material.Filled.Person"
                 Color="Color.Primary"
                 Variant="Variant.Filled"
                 Size="Size.Medium"
                 AriaLabel="Open user menu"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight">
            <MudMenuItem Href="@uiReactUrl" Target="_blank">UI React</MudMenuItem>
            <MudMenuItem Href="@mvcUrl" Target="_blank">MVC</MudMenuItem>
            <MudMenuItem Href="@apiAboutUrl" Target="_blank">API About</MudMenuItem>
            <MudMenuItem Href="@workerHangfireUrl" Target="_blank">Worker Hangfire</MudMenuItem>
            <MudDivider />
            <MudMenuItem Href="/presentation">Presentation</MudMenuItem>
            <MudDivider />
            <MudMenuItem OnClick="OpenAboutModal">About</MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <MudMainContent Class="d-flex flex-column" Style="height: 100vh; overflow-y: auto;">
        @Body
    </MudMainContent>
</MudLayout>

<MudDialog @bind-Visible="_isAboutModalOpen" Options="_aboutDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">About</MudText>
    </TitleContent>
    <DialogContent>
        @if (_isAboutLoading)
        {
            <div class="d-flex align-center gap-3">
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
                <MudText>Loading About information...</MudText>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_aboutError))
        {
            <MudAlert Severity="Severity.Error">@_aboutError</MudAlert>
        }
        else if (_aboutRoot is not null)
        {
            <ul class="about-tree-list root">
                <AboutTreeNode Node="_aboutRoot" />
            </ul>
        }

        <MudDivider Class="my-4" />

        <div class="d-flex flex-wrap gap-4">
            <MudLink Href="@uiReactUrl" Target="_blank">UI React</MudLink>
            <MudLink Href="@mvcUrl" Target="_blank">MVC</MudLink>
            <MudLink Href="@apiAboutUrl" Target="_blank">API About</MudLink>
            <MudLink Href="@workerHangfireUrl" Target="_blank">Worker Hangfire</MudLink>
            <MudLink Href="https://github.com/dustinkorzaan/weather-1116" Target="_blank">GitHub</MudLink>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseAboutModal">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly DialogOptions _aboutDialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true,
        CloseOnEscapeKey = true,
    };

    private bool _isAboutModalOpen;
    private bool _isAboutLoading;
    private string _aboutError = string.Empty;
    private AboutNode? _aboutRoot;

    private async Task OpenAboutModal()
    {
        _isAboutModalOpen = true;
        _isAboutLoading = true;
        _aboutError = string.Empty;

        try
        {
            _aboutRoot = await WeatherClient.GetAbout();
            if (_aboutRoot is null)
            {
                _aboutError = "Unable to load About information.";
            }
        }
        catch
        {
            _aboutRoot = null;
            _aboutError = "Unable to load About information.";
        }
        finally
        {
            _isAboutLoading = false;
        }
    }

    private void CloseAboutModal()
    {
        _isAboutModalOpen = false;
    }
}
