@using System.Globalization
@using WeatherBlazor.Data

@if (Node is not null)
{
    <li class="my-2">
        <div class="d-flex flex-wrap align-center gap-2">
            <MudText Typo="Typo.body1" Class="fw-bold">@(Node.Name ?? "Unnamed node")</MudText>
            <span class="about-tree-health rounded-pill px-2 @(Node.IsHealthy ? "mud-theme-success" : "mud-theme-error")">
                @(Node.IsHealthy ? "Healthy" : "Unhealthy")
            </span>
        </div>
        @if (!string.IsNullOrWhiteSpace(Node.PublicMessage))
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Node.PublicMessage</MudText>
        }
        @if (Node.BuildNumber.HasValue || Node.BuildStart.HasValue || !string.IsNullOrWhiteSpace(Node.BuildBranchName))
        {
            <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">
                @if (Node.BuildNumber.HasValue)
                {
                    <span>Build #@Node.BuildNumber</span>
                }
                @if (Node.BuildStart.HasValue)
                {
                    @if (Node.BuildNumber.HasValue)
                    {
                        <span> | </span>
                    }
                    <span>Started @FormatBuildStart(Node.BuildStart.Value)</span>
                }
                @if (!string.IsNullOrWhiteSpace(Node.BuildBranchName))
                {
                    @if (Node.BuildNumber.HasValue || Node.BuildStart.HasValue)
                    {
                        <span> | </span>
                    }
                    <span class="@(Node.BuildBranchName == "main" ? null : "mud-warning-text")">Branch @Node.BuildBranchName</span>
                }
            </MudText>
        }

        @if (Node.Children.Count > 0)
        {
            <ul class="about-tree-list">
                @foreach (var child in Node.Children)
                {
                    <AboutTreeNode Node="child" />
                }
            </ul>
        }
    </li>
}

@code {
    [Parameter, EditorRequired]
    public AboutNode? Node { get; set; }

    /// <summary>Formats a build timestamp like "7/12/2026 10:22:14 PM UTC" (matches MVC and React).</summary>
    private static string FormatBuildStart(DateTime buildStart)
        => buildStart.ToString("M/d/yyyy h:mm:ss tt 'UTC'", CultureInfo.InvariantCulture);
}
