@using WeatherBlazor.Data

<div class="wind-direction">
    @WeatherGridFormat.FormatWindDirection(Compass, Degrees)
    @if (WeatherGridFormat.WindArrowRotationDeg(Degrees) is double rotation)
    {
        <span class="wind-direction-arrow"
              aria-hidden="true"
              style="@($"transform: rotate({rotation}deg)")">&#x2B9B;</span>
    }
</div>

@code {
    [Parameter]
    public string Compass { get; set; } = string.Empty;

    [Parameter]
    public double Degrees { get; set; }
}
