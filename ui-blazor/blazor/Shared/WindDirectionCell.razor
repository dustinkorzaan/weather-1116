@using WeatherBlazor.Data

<div class="wind-direction">
    @WeatherGridFormat.FormatWindDirection(Degrees)
    @if (!double.IsNaN(Degrees) && !double.IsInfinity(Degrees))
    {
        var rotation = (int)Math.Round(((Degrees % 360) + 360) % 360);
        <span class="wind-direction-arrow"
              aria-hidden="true"
              style="@($"transform: rotate({rotation}deg)")">&#x2B9B;</span>
    }
</div>

@code {
    [Parameter]
    public double Degrees { get; set; }
}
