@* Current AI Weather tab content for the weather modal. Copied (not shared) from
   CurrentAIWeather.razor's results rendering, minus the location input/form — the
   demo page at /current-ai-weather has its own design constraints and evolves separately. *@
@using System.Globalization
@using WeatherBlazor.Data
@inject WeatherApiClient WeatherClient

<section aria-labelledby="current-ai-weather-modal-heading">
    <div class="inline-row" style="justify-content: space-between;">
        <h2 id="current-ai-weather-modal-heading" class="section-title" style="margin: 0;">Current AI Weather</h2>
        <button type="button"
                class="icon-button"
                disabled="@_isLoading"
                @onclick="RefreshAsync"
                aria-label="Refresh Current AI Weather">
            <svg class="@(_isLoading ? "is-spinning" : null)" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                <path d="M3 3v5h5" />
                <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
                <path d="M16 16h5v5" />
            </svg>
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false" Class="stack-gap">@_errorMessage</FluentMessageBar>
    }

    @if (_isLoading)
    {
        <p class="stat-label stack-gap">Connecting to Microsoft Foundry...</p>
    }

    @if (_aiWeather is not null && !_isLoading)
    {
        <div class="weather-results">
            <div class="chat-markdown">@((MarkupString)SafeGfmMarkdown.ToHtml(_aiWeather.FullSummary))</div>
            <FluentGrid Spacing="2">
                <FluentGridItem xs="12" sm="6">
                    <div class="stat-label">Temperature</div>
                    <div>@FormatTemperatureF(_aiWeather.TemperatureF)</div>
                </FluentGridItem>
                <FluentGridItem xs="12" sm="6">
                    <div class="stat-label">Wind Speed</div>
                    <div>@FormatWindSpeedMph(_aiWeather.WindSpeedMPH)</div>
                </FluentGridItem>
                <FluentGridItem xs="12" sm="6">
                    <div class="stat-label">Wind Direction</div>
                    <div class="wind-direction">
                        @WeatherGridFormat.FormatWindDirection(_aiWeather.WindDirectionSource, _aiWeather.WindDirectionSourceDegrees)
                        <span class="wind-direction-arrow"
                              aria-hidden="true"
                              style="@($"transform: rotate({WeatherGridFormat.NormalizeSourceDegrees(_aiWeather.WindDirectionSourceDegrees)}deg)")">v</span>
                    </div>
                </FluentGridItem>
                <FluentGridItem xs="12" sm="6">
                    <div class="stat-label">Conditions</div>
                    <div>@_aiWeather.Conditions</div>
                </FluentGridItem>
                <FluentGridItem xs="12" sm="6">
                    <div class="stat-label">Lat/Long</div>
                    <div>@FormatLatLong(_aiWeather.Latitude, _aiWeather.Longitude)</div>
                </FluentGridItem>
            </FluentGrid>
            @if (_aiWeather.RunLogDetails.Count > 0)
            {
                <div class="weather-grid-wrap" style="margin-top: 1rem;">
                    <table class="weather-grid">
                        <thead>
                            <tr>
                                <th>Time (UTC)</th><th>Loop</th><th>Message</th><th>Input (tokens)</th><th>Cached (tokens)</th>
                                <th>Output (tokens)</th><th>Reasoning (tokens)</th><th>Total (tokens)</th><th>Running Total (tokens)</th>
                                <th>Runtime (ms)</th><th>Loop Runtime (ms)</th><th>Running Total (ms)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in _aiWeather.RunLogDetails)
                            {
                                <tr>
                                    <td>@WeatherGridFormat.FormatRunLogTimestamp(entry.DateTimeUtc)</td>
                                    <td>@entry.LoopNumber</td>
                                    <td>@entry.Message</td>
                                    <td>@WeatherGridFormat.FormatRunLogTokenCount(entry.InputTokenCount)</td>
                                    <td>@WeatherGridFormat.FormatRunLogTokenCount(entry.CachedTokenCount)</td>
                                    <td>@WeatherGridFormat.FormatRunLogTokenCount(entry.OutputTokenCount)</td>
                                    <td>@WeatherGridFormat.FormatRunLogTokenCount(entry.ReasoningTokenCount)</td>
                                    <td>@WeatherGridFormat.FormatRunLogTokenCount(entry.TotalTokenCount)</td>
                                    <td>@WeatherGridFormat.FormatRunLogTokenCount(entry.RunningTotalTokenCount)</td>
                                    <td>@WeatherGridFormat.FormatRunLogMs(entry.RuntimeMs)</td>
                                    <td>@WeatherGridFormat.FormatRunLogMs(entry.LoopRuntimeMs)</td>
                                    <td>@WeatherGridFormat.FormatRunLogMs(entry.RunningTotalMs)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="stat-label" style="margin-top: 0.5rem;">Total Runtime: @WeatherGridFormat.FormatRunLogMs(_aiWeather.RunLogDetails[^1].RunningTotalMs) ms</p>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public string Location { get; set; } = string.Empty;

    private bool _isLoading;
    private string? _errorMessage;
    private AIWeatherResponse? _aiWeather;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrWhiteSpace(Location))
        {
            return;
        }

        await LoadAsync();
    }

    private async Task RefreshAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _aiWeather = null;
        StateHasChanged();

        try
        {
            _aiWeather = await WeatherClient.GetCurrentAIWeatherV3(Location);
            if (_aiWeather is null)
            {
                _errorMessage = "Unable to load AI weather.";
            }
        }
        catch
        {
            _aiWeather = null;
            _errorMessage = "Unable to load AI weather.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static string FormatTemperatureF(double value) =>
        string.Create(CultureInfo.InvariantCulture, $"{value} °F");

    private static string FormatWindSpeedMph(double value) =>
        string.Create(CultureInfo.InvariantCulture, $"{value} mph");

    private static string FormatLatLong(double latitude, double longitude) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"{FormatHemisphereDegrees(latitude, "N", "S")}, {FormatHemisphereDegrees(longitude, "E", "W")}");

    private static string FormatHemisphereDegrees(double value, string positiveLabel, string negativeLabel)
    {
        var hemisphere = value >= 0 ? positiveLabel : negativeLabel;
        return string.Create(CultureInfo.InvariantCulture, $"{Math.Abs(value):0.00}° {hemisphere}");
    }
}
