@inject IConfiguration Configuration
@using System.Text.Json

<section class="weather-map-section" aria-label="Map">
    @if (string.IsNullOrWhiteSpace(_apiKey))
    {
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            Set GOOGLE_MAPS_API_KEY in appsettings (or env GOOGLE_MAPS_API_KEY) to enable Google Maps.
        </FluentMessageBar>
    }

    @* Map is initialized by wwwroot/js/weatherMap.js from these data attributes.
       That keeps the map working even when the Blazor SignalR circuit is slow or fails. *@
    <div class="weather-map-canvas-wrap">
        <div id="weather-map"
             class="weather-map"
             data-google-maps-key="@_apiKey"
             data-cities="@_citiesJson"
             data-get-location-url="/Geo/GetLocation"
             data-status="@(string.IsNullOrWhiteSpace(_apiKey) ? "missing-key" : "pending")"></div>
    </div>
</section>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
    };

    private static readonly object[] Cities =
    [
        new { id = new Guid("59e2459a-b25d-44a7-bcb0-2a4f2e444272"), name = "New York, NY", lat = 40.7128, lng = -74.006 },
        new { id = new Guid("329735f1-cfc0-42b4-a48f-0d41677145e8"), name = "Toronto, ON", lat = 43.6532, lng = -79.3832 },
        new { id = new Guid("9daab691-7885-400f-8aed-5e21a63f9a7a"), name = "Atlanta, GA", lat = 33.749, lng = -84.388 },
        new { id = new Guid("04f5d22f-ca31-4d29-ac9e-a1c4f0127ed1"), name = "Charlotte, NC", lat = 35.2271, lng = -80.8431 },
    ];

    private string _apiKey = "";
    private string _citiesJson = "[]";

    protected override void OnInitialized()
    {
        _apiKey = Configuration["GOOGLE_MAPS_API_KEY"] ?? "";
        _citiesJson = JsonSerializer.Serialize(Cities, JsonOptions);
    }
}
