@inject IConfiguration Configuration

<section class="weather-map-section" aria-label="Map">
    @if (string.IsNullOrWhiteSpace(_apiKey))
    {
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            Set GOOGLE_MAPS_API_KEY in appsettings (or env GOOGLE_MAPS_API_KEY) to enable Google Maps.
        </FluentMessageBar>
    }

    @* Map is initialized by wwwroot/js/weatherMap.js from these data attributes, and the
       script loads saved pins from /User itself. That keeps the map working even when the
       Blazor SignalR circuit is slow or fails. *@
    <div class="weather-map-canvas-wrap">
        <div id="weather-map"
             class="weather-map"
             data-google-maps-key="@_apiKey"
             data-get-location-url="/Geo/GetLocation"
             data-status="@(string.IsNullOrWhiteSpace(_apiKey) ? "missing-key" : "pending")"></div>
    </div>
</section>

@code {
    private string _apiKey = "";

    protected override void OnInitialized()
    {
        _apiKey = Configuration["GOOGLE_MAPS_API_KEY"] ?? "";
    }
}
