@inject IConfiguration Configuration
@using System.Text.Json
@using System.Net.Http
@using System.Net.Http.Json

<section class="weather-map-section" aria-label="Map">
    @if (string.IsNullOrWhiteSpace(_apiKey))
    {
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            Set GOOGLE_MAPS_API_KEY in appsettings (or env GOOGLE_MAPS_API_KEY) to enable Google Maps.
        </FluentMessageBar>
    }

    @* Map is initialized by wwwroot/js/weatherMap.js from these data attributes.
       That keeps the map working even when the Blazor SignalR circuit is slow or fails. *@
    <div class="weather-map-canvas-wrap">
        <div id="weather-map"
             class="weather-map"
             data-google-maps-key="@_apiKey"
             data-cities="@_citiesJson"
             data-get-location-url="/Geo/GetLocation"
             data-status="@(string.IsNullOrWhiteSpace(_apiKey) ? "missing-key" : "pending")"></div>
    </div>
</section>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
    };

    [Inject]
    private HttpClient HttpClient { get; set; } = default!;

    private string _apiKey = "";
    private string _citiesJson = "[]";

    protected override async Task OnInitializedAsync()
    {
        _apiKey = Configuration["GOOGLE_MAPS_API_KEY"] ?? "";

        try
        {
            var response = await HttpClient.GetAsync("/User");
            if (response.IsSuccessStatusCode)
            {
                var responseJson = await response.Content.ReadAsStringAsync();
                using (var doc = JsonDocument.Parse(responseJson))
                {
                    var root = doc.RootElement;
                    var userPinsElement = root.GetProperty("userPins");
                    var pins = userPinsElement.EnumerateArray().Select(pin => new
                    {
                        id = pin.GetProperty("id").GetString(),
                        name = pin.GetProperty("locationName").GetString(),
                        lat = pin.GetProperty("latitude").GetDouble(),
                        lng = pin.GetProperty("longitude").GetDouble(),
                    }).ToList();
                    _citiesJson = JsonSerializer.Serialize(pins, JsonOptions);
                }
            }
        }
        catch
        {
            // If fetching user data fails, initialize with empty array
            _citiesJson = "[]";
        }
    }
}
