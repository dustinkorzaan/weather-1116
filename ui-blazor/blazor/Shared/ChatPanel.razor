@using WeatherBlazor.Data
@inject ChatApiClient ChatClient
@inject IJSRuntime JS

<div class="chat-section">
    <h2 class="section-title">Chat Clients</h2>
    <p class="muted">
        Nine standalone chat tabs: Responses API vs Agent Framework (V3 in-process / V4 MCP), plus Chat3 against a hosted Foundry agent (V5), plus Chat4a and Chat4b's multi-agent orchestration (AI Weather Orchestration delegating to Geo and NonAI Weather, in-process for Chat4a and remote MCP for Chat4b), plus Chat5a and Chat5b, the same orchestration with five toggleable guardrail gates.
    </p>

    <FluentTabs @bind-ActiveTabId="ActiveTab">
        @foreach (var tab in _tabs)
        {
            <FluentTab Id="@tab.Id" Label="@tab.Label" title="@tab.Label">
                <Header>@tab.ShortLabel</Header>
            </FluentTab>
        }
    </FluentTabs>

    <p class="muted tab-description">@_tabs.First(tab => tab.Id == _activeTab).Description</p>

    <div class="chat-window">
    <FluentCard Class="chat-card" aria-label="Chat conversation">
        <div @ref="_messagesElement" class="chat-messages">
            @foreach (var entry in _histories[_activeTab])
            {
                @if (entry.Role == "assistant" && !entry.Streaming)
                {
                    <div class="chat-message assistant chat-markdown">
                        @((MarkupString)SafeGfmMarkdown.ToHtml(entry.Content))
                        @if (!string.IsNullOrEmpty(WeatherGridFormat.FormatChatUsageChip(entry.Usage)))
                        {
                            <span class="chat-usage-chip" @attributes="UsageHoverAttributes(entry)">@WeatherGridFormat.FormatChatUsageChip(entry.Usage)</span>
                        }
                    </div>
                }
                else
                {
                    <div class="@MessageClass(entry.Role)" @attributes="ToolHoverAttributes(entry)">@entry.Content</div>
                }
            }
        </div>

        <EditForm Model="this" OnValidSubmit="OnSubmit" class="chat-form" @onsubmit:preventDefault="true">
            <div class="form-row form-row-start">
                @* Uncontrolled textarea: Immediate @bind sent every keystroke through the
                   Blazor Server circuit and wrote a stale value back, which jumped the caret
                   and dropped characters. chatInput.js owns the draft until submit. *@
                <textarea @ref="_inputElement"
                          class="chat-input"
                          rows="3"
                          placeholder="Ask about weather in a city…"
                          aria-label="Message"
                          disabled="@IsActiveTabSending"></textarea>
                <FluentButton Type="ButtonType.Submit"
                              Appearance="Appearance.Outline"
                              Disabled="IsActiveTabSending">
                    @(IsActiveTabSending ? "Sending…" : "Send")
                </FluentButton>
            </div>
        </EditForm>
        @if (_gateStateByTab.TryGetValue(_activeTab, out var gateState))
        {
            <div class="chat-gate-options">
                <label title="Pre-Orchestration - Deterministic Max Length. Blocks the request if the message is over 500 characters.">
                    <input type="checkbox" @bind="gateState.MaxLength" /> 500 Char
                </label>
                <label title="Pre-Orchestration - Deterministic Input Check. A keyword/regex heuristic classifies the message as in/out of scope, no LLM call.">
                    <input type="checkbox" @bind="gateState.RuleInput" /> Code Input
                </label>
                <label title="Pre-Orchestration - LLM-based Input Check. A separate, cheap LLM call classifies the message as in/out of scope before the orchestrator runs.">
                    <input type="checkbox" @bind="gateState.LlmInput" /> LLM Input
                </label>
                <label title="Orchestration - Prompt-based Scope Guard. An instruction in the orchestrator's own system prompt telling it to only answer weather questions (not a location by itself) — no code enforces this, so it's the easiest gate to bypass.">
                    <input type="checkbox" @bind="gateState.SystemPrompt" /> Sys Prompt
                </label>
                <label title="Post-Orchestration - LLM-based Output Check. A separate LLM call classifies the full response before it's shown. You will have to wait for the complete reply to finish generating before you see any of it, since streaming is disabled for that turn.">
                    <input type="checkbox" @bind="gateState.LlmOutput" /> LLM Output (waits for full reply)
                </label>
            </div>
        }
    </FluentCard>
    </div>
</div>

@code {
    private sealed record ChatTab(string Id, string Label, string ShortLabel, string Description);

    private readonly ChatTab[] _tabs =
    [
        new("Chat1a", "Chat1a", "1a", "Responses API · Local Loops · Like Foundry Console V3"),
        new("Chat1b", "Chat1b", "1b", "Responses API · Remote MCP · Like Foundry Console V4"),
        new("Chat2a", "Chat2a", "2a", "Agent Framework · Local Loops · Like Foundry Console V3"),
        new("Chat2b", "Chat2b", "2b", "Agent Framework · Remote MCP · Like Foundry Console V4"),
        new("Chat3", "Chat3", "3", "Hosted Foundry agent · Like Foundry Console V5"),
        new("Chat4a", "Chat4a", "4a", "Agent Framework · Local Loops · Multi-agent · Orchestration agent delegates to Geo and NonAI Weather Agents (invalid Token Counts)"),
        new("Chat4b", "Chat4b", "4b", "Agent Framework · Remote MCP · Multi-agent · Orchestration agent delegates to Geo and NonAI Weather Agents (invalid Token Counts)"),
        new("Chat5a", "Chat5a", "5a", "Agent Framework · Local Loops · Multi-agent · Orchestration agent delegates to Geo and NonAI Weather Agents · 5 Guardrailed (invalid Token Counts)"),
        new("Chat5b", "Chat5b", "5b", "Agent Framework · Remote MCP · Multi-agent · Orchestration agent delegates to Geo and NonAI Weather Agents · 5 Guardrailed (invalid Token Counts)"),
    ];

    private readonly Dictionary<string, string?> _sessions = new()
    {
        ["Chat1a"] = null,
        ["Chat1b"] = null,
        ["Chat2a"] = null,
        ["Chat2b"] = null,
        ["Chat3"] = null,
        ["Chat4a"] = null,
        ["Chat4b"] = null,
        ["Chat5a"] = null,
        ["Chat5b"] = null,
    };

    private readonly Dictionary<string, List<ChatEntry>> _histories = new()
    {
        ["Chat1a"] = [],
        ["Chat1b"] = [],
        ["Chat2a"] = [],
        ["Chat2b"] = [],
        ["Chat3"] = [],
        ["Chat4a"] = [],
        ["Chat4b"] = [],
        ["Chat5a"] = [],
        ["Chat5b"] = [],
    };

    // Chat5a/Chat5b only — all five gates default checked, independently per tab.
    private sealed class Chat5GateState
    {
        public bool MaxLength { get; set; } = true;
        public bool RuleInput { get; set; } = true;
        public bool LlmInput { get; set; } = true;
        public bool SystemPrompt { get; set; } = true;
        public bool LlmOutput { get; set; } = true;
    }

    private readonly Dictionary<string, Chat5GateState> _gateStateByTab = new()
    {
        ["Chat5a"] = new Chat5GateState(),
        ["Chat5b"] = new Chat5GateState(),
    };

    private string _activeTab = "Chat1a";
    private ElementReference _inputElement;
    private ElementReference _messagesElement;
    private bool _scrollMessagesPending;

    private string ActiveTab
    {
        get => _activeTab;
        set
        {
            if (_activeTab == value)
            {
                return;
            }

            _activeTab = value;
            _scrollMessagesPending = true;
        }
    }

    private readonly Dictionary<string, bool> _isSendingByTab = new()
    {
        ["Chat1a"] = false,
        ["Chat1b"] = false,
        ["Chat2a"] = false,
        ["Chat2b"] = false,
        ["Chat3"] = false,
        ["Chat4a"] = false,
        ["Chat4b"] = false,
        ["Chat5a"] = false,
        ["Chat5b"] = false,
    };

    private bool IsActiveTabSending => _isSendingByTab[_activeTab];

    private sealed class ChatEntry
    {
        public required string Role { get; set; }
        public required string Content { get; set; }
        public string? ToolName { get; set; }
        public string? ToolArguments { get; set; }
        public string? ToolResult { get; set; }
        public bool Running { get; set; }
        public bool Streaming { get; set; }
        public ChatUsage? Usage { get; set; }
    }

    private static string MessageClass(string role) => role switch
    {
        "user" => "chat-message user",
        "tool" => "chat-message tool",
        "error" => "chat-message error",
        "blocked" => "chat-message blocked",
        _ => "chat-message assistant",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollMessagesPending)
        {
            return;
        }

        _scrollMessagesPending = false;
        await JS.InvokeVoidAsync("chatInput.scrollToBottom", _messagesElement);
    }

    private void RequestScrollToBottom(string tabId)
    {
        if (tabId == _activeTab)
        {
            _scrollMessagesPending = true;
        }
    }

    private static string? ToolHoverText(ChatEntry entry)
    {
        if (entry.Role != "tool")
        {
            return null;
        }

        var sections = new List<string>();
        if (!string.IsNullOrWhiteSpace(entry.ToolArguments))
        {
            sections.Add($"Arguments\n{entry.ToolArguments}");
        }

        if (!string.IsNullOrWhiteSpace(entry.ToolResult))
        {
            sections.Add($"Result\n{entry.ToolResult}");
        }

        if (sections.Count == 0)
        {
            return entry.Running ? "Waiting for tool output…" : null;
        }

        return string.Join("\n\n", sections);
    }

    private static Dictionary<string, object>? ToolHoverAttributes(ChatEntry entry)
    {
        var hoverText = ToolHoverText(entry);
        if (string.IsNullOrEmpty(hoverText))
        {
            return null;
        }

        return new Dictionary<string, object>
        {
            ["data-tool-details"] = hoverText,
            ["tabindex"] = 0,
        };
    }

    private static Dictionary<string, object>? UsageHoverAttributes(ChatEntry entry)
    {
        var details = WeatherGridFormat.FormatChatUsageDetails(entry.Usage);
        if (string.IsNullOrEmpty(details) || string.IsNullOrEmpty(WeatherGridFormat.FormatChatUsageChip(entry.Usage)))
        {
            return null;
        }

        return new Dictionary<string, object>
        {
            ["data-tool-details"] = details,
            ["tabindex"] = 0,
        };
    }

    private async Task<string> ReadComposerValueAsync()
    {
        try
        {
            return await JS.InvokeAsync<string>("chatInput.getValue", _inputElement) ?? string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }

    private async Task ClearComposerValueAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("chatInput.setValue", _inputElement, string.Empty);
        }
        catch
        {
            // Tests and missing script leave the textarea as-is.
        }
    }

    private async Task OnSubmit()
    {
        var message = (await ReadComposerValueAsync()).Trim();
        if (string.IsNullOrWhiteSpace(message) || _isSendingByTab[_activeTab])
        {
            return;
        }

        // The active tab can change while the stream is in flight.
        var tabId = _activeTab;
        var history = _histories[tabId];

        await ClearComposerValueAsync();
        _isSendingByTab[tabId] = true;
        history.Add(new ChatEntry { Role = "user", Content = message });

        var assistantBuilder = new System.Text.StringBuilder();
        ChatEntry? assistantEntry = null;

        var chatEvents = _gateStateByTab.TryGetValue(tabId, out var gateState)
            ? ChatClient.StreamMessageAsync(
                tabId,
                new Chat5SendMessageRequest
                {
                    SessionId = _sessions[tabId],
                    Message = message,
                    EnableMaxLengthGate = gateState.MaxLength,
                    EnableRuleInputGate = gateState.RuleInput,
                    EnableLlmInputGate = gateState.LlmInput,
                    EnableSystemPromptGuard = gateState.SystemPrompt,
                    EnableLlmOutputGate = gateState.LlmOutput,
                },
                CancellationToken.None)
            : ChatClient.StreamMessageAsync(
                tabId,
                new ChatSendMessageRequest { SessionId = _sessions[tabId], Message = message },
                CancellationToken.None);

        try
        {
            await foreach (var streamEvent in chatEvents)
            {
                if (streamEvent.Type == "session" && !string.IsNullOrWhiteSpace(streamEvent.SessionId))
                {
                    _sessions[tabId] = streamEvent.SessionId;
                }
                else if (streamEvent.Type == "token" && !string.IsNullOrEmpty(streamEvent.Text))
                {
                    assistantBuilder.Append(streamEvent.Text);
                    if (assistantEntry is null)
                    {
                        assistantEntry = new ChatEntry
                        {
                            Role = "assistant",
                            Content = assistantBuilder.ToString(),
                            Streaming = true,
                        };
                        history.Add(assistantEntry);
                    }
                    else
                    {
                        assistantEntry.Content = assistantBuilder.ToString();
                    }

                    StateHasChanged();
                }
                else if (streamEvent.Type == "tool_start" && !string.IsNullOrEmpty(streamEvent.ToolName))
                {
                    history.Add(new ChatEntry
                    {
                        Role = "tool",
                        Content = $"Running {streamEvent.ToolName} …",
                        ToolName = streamEvent.ToolName,
                        ToolArguments = streamEvent.ToolArguments,
                        Running = true,
                    });
                    StateHasChanged();
                }
                else if (streamEvent.Type == "tool_end" && !string.IsNullOrEmpty(streamEvent.ToolName))
                {
                    var pending = history.LastOrDefault(entry => entry.Running && entry.ToolName == streamEvent.ToolName);
                    if (pending is not null)
                    {
                        pending.Running = false;
                        pending.Content = $"Ran {streamEvent.ToolName} …";
                        pending.ToolArguments = streamEvent.ToolArguments ?? pending.ToolArguments;
                        pending.ToolResult = streamEvent.ToolResult;
                        StateHasChanged();
                    }
                }
                else if (streamEvent.Type == "error" && !string.IsNullOrEmpty(streamEvent.ErrorMessage))
                {
                    history.Add(new ChatEntry { Role = "error", Content = streamEvent.ErrorMessage });
                    StateHasChanged();
                }
                else if (streamEvent.Type == "blocked" && !string.IsNullOrEmpty(streamEvent.ErrorMessage))
                {
                    history.Add(new ChatEntry { Role = "blocked", Content = streamEvent.ErrorMessage });
                    StateHasChanged();
                }
                else if (streamEvent.Type == "done")
                {
                    if (assistantEntry is not null)
                    {
                        assistantEntry.Streaming = false;
                        assistantEntry.Usage = streamEvent.Usage;
                    }

                    RequestScrollToBottom(tabId);
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            history.Add(new ChatEntry { Role = "error", Content = ex.Message });
        }
        finally
        {
            _isSendingByTab[tabId] = false;
            if (assistantEntry is not null)
            {
                assistantEntry.Streaming = false;
            }

            RequestScrollToBottom(tabId);
        }
    }
}
