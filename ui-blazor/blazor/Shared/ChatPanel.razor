@using WeatherBlazor.Data
@inject ChatApiClient ChatClient
@inject IJSRuntime JS

<div class="chat-section">
    <h2 class="section-title">Chat Clients</h2>
    <p class="muted">
        Five standalone chat tabs: Responses API vs Agent Framework (V3 in-process / V4 MCP), plus Chat3 against a hosted Foundry agent (V5).
    </p>

    <FluentTabs @bind-ActiveTabId="ActiveTab">
        @foreach (var tab in _tabs)
        {
            <FluentTab Id="@tab.Id" Label="@tab.Label"></FluentTab>
        }
    </FluentTabs>

    <p class="muted tab-description">@_tabs.First(tab => tab.Id == _activeTab).Description</p>

    <div class="chat-window">
    <FluentCard Class="chat-card" aria-label="Chat conversation">
        <div class="chat-window-toolbar">
            <button type="button"
                    class="chat-fullscreen-button"
                    data-chat-fullscreen-button
                    aria-label="Enter fullscreen"
                    aria-pressed="false"
                    title="Enter fullscreen">
                <svg data-icon="enter" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 3 21 3 21 9" />
                    <polyline points="9 21 3 21 3 15" />
                    <line x1="21" x2="14" y1="3" y2="10" />
                    <line x1="3" x2="10" y1="21" y2="14" />
                </svg>
                <svg data-icon="exit" hidden xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="4 14 10 14 10 20" />
                    <polyline points="20 10 14 10 14 4" />
                    <line x1="14" x2="21" y1="10" y2="3" />
                    <line x1="3" x2="10" y1="21" y2="14" />
                </svg>
            </button>
        </div>
        <div @ref="_messagesElement" class="chat-messages">
            @foreach (var entry in _histories[_activeTab])
            {
                @if (entry.Role == "assistant" && !entry.Streaming)
                {
                    <div class="chat-message assistant chat-markdown">@((MarkupString)SafeGfmMarkdown.ToHtml(entry.Content))</div>
                }
                else
                {
                    <div class="@MessageClass(entry.Role)" @attributes="ToolHoverAttributes(entry)">@entry.Content</div>
                }
            }
        </div>

        <EditForm Model="this" OnValidSubmit="OnSubmit" class="chat-form" @onsubmit:preventDefault="true">
            <div class="form-row form-row-start">
                @* Uncontrolled textarea: Immediate @bind sent every keystroke through the
                   Blazor Server circuit and wrote a stale value back, which jumped the caret
                   and dropped characters. chatInput.js owns the draft until submit. *@
                <textarea @ref="_inputElement"
                          class="chat-input"
                          rows="3"
                          placeholder="Ask about weather in a city…"
                          aria-label="Message"
                          disabled="@IsActiveTabSending"></textarea>
                <FluentButton Type="ButtonType.Submit"
                              Appearance="Appearance.Outline"
                              Disabled="IsActiveTabSending">
                    @(IsActiveTabSending ? "Sending…" : "Send")
                </FluentButton>
            </div>
        </EditForm>
    </FluentCard>
    </div>
</div>

@code {
    private sealed record ChatTab(string Id, string Label, string Description);

    private readonly ChatTab[] _tabs =
    [
        new("Chat1a", "Chat1a", "In-process · Responses API · Like Foundry Console V3"),
        new("Chat1b", "Chat1b", "Remote MCP · Responses API · Like Foundry Console V4"),
        new("Chat2a", "Chat2a", "In-process · Agent Framework · Like Foundry Console V3"),
        new("Chat2b", "Chat2b", "Remote MCP · Agent Framework · Like Foundry Console V4"),
        new("Chat3", "Chat3", "Hosted Foundry agent · Like Foundry Console V5"),
    ];

    private readonly Dictionary<string, string?> _sessions = new()
    {
        ["Chat1a"] = null,
        ["Chat1b"] = null,
        ["Chat2a"] = null,
        ["Chat2b"] = null,
        ["Chat3"] = null,
    };

    private readonly Dictionary<string, List<ChatEntry>> _histories = new()
    {
        ["Chat1a"] = [],
        ["Chat1b"] = [],
        ["Chat2a"] = [],
        ["Chat2b"] = [],
        ["Chat3"] = [],
    };

    private string _activeTab = "Chat1a";
    private ElementReference _inputElement;
    private ElementReference _messagesElement;
    private bool _scrollMessagesPending;

    private string ActiveTab
    {
        get => _activeTab;
        set
        {
            if (_activeTab == value)
            {
                return;
            }

            _activeTab = value;
            _scrollMessagesPending = true;
        }
    }

    private readonly Dictionary<string, bool> _isSendingByTab = new()
    {
        ["Chat1a"] = false,
        ["Chat1b"] = false,
        ["Chat2a"] = false,
        ["Chat2b"] = false,
        ["Chat3"] = false,
    };

    private bool IsActiveTabSending => _isSendingByTab[_activeTab];

    private sealed class ChatEntry
    {
        public required string Role { get; set; }
        public required string Content { get; set; }
        public string? ToolName { get; set; }
        public string? ToolArguments { get; set; }
        public string? ToolResult { get; set; }
        public bool Running { get; set; }
        public bool Streaming { get; set; }
    }

    private static string MessageClass(string role) => role switch
    {
        "user" => "chat-message user",
        "tool" => "chat-message tool",
        "error" => "chat-message error",
        _ => "chat-message assistant",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollMessagesPending)
        {
            return;
        }

        _scrollMessagesPending = false;
        await JS.InvokeVoidAsync("chatInput.scrollToBottom", _messagesElement);
    }

    private void RequestScrollToBottom(string tabId)
    {
        if (tabId == _activeTab)
        {
            _scrollMessagesPending = true;
        }
    }

    private static string? ToolHoverText(ChatEntry entry)
    {
        if (entry.Role != "tool")
        {
            return null;
        }

        var sections = new List<string>();
        if (!string.IsNullOrWhiteSpace(entry.ToolArguments))
        {
            sections.Add($"Arguments\n{entry.ToolArguments}");
        }

        if (!string.IsNullOrWhiteSpace(entry.ToolResult))
        {
            sections.Add($"Result\n{entry.ToolResult}");
        }

        if (sections.Count == 0)
        {
            return entry.Running ? "Waiting for tool output…" : null;
        }

        return string.Join("\n\n", sections);
    }

    private static Dictionary<string, object>? ToolHoverAttributes(ChatEntry entry)
    {
        var hoverText = ToolHoverText(entry);
        if (string.IsNullOrEmpty(hoverText))
        {
            return null;
        }

        return new Dictionary<string, object>
        {
            ["data-tool-details"] = hoverText,
            ["tabindex"] = 0,
        };
    }

    private async Task<string> ReadComposerValueAsync()
    {
        try
        {
            return await JS.InvokeAsync<string>("chatInput.getValue", _inputElement) ?? string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }

    private async Task ClearComposerValueAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("chatInput.setValue", _inputElement, string.Empty);
        }
        catch
        {
            // Tests and missing script leave the textarea as-is.
        }
    }

    private async Task OnSubmit()
    {
        var message = (await ReadComposerValueAsync()).Trim();
        if (string.IsNullOrWhiteSpace(message) || _isSendingByTab[_activeTab])
        {
            return;
        }

        // The active tab can change while the stream is in flight.
        var tabId = _activeTab;
        var history = _histories[tabId];

        await ClearComposerValueAsync();
        _isSendingByTab[tabId] = true;
        history.Add(new ChatEntry { Role = "user", Content = message });

        var assistantBuilder = new System.Text.StringBuilder();
        ChatEntry? assistantEntry = null;

        try
        {
            await foreach (var streamEvent in ChatClient.StreamMessageAsync(
                tabId,
                new ChatSendMessageRequest { SessionId = _sessions[tabId], Message = message },
                CancellationToken.None))
            {
                if (streamEvent.Type == "session" && !string.IsNullOrWhiteSpace(streamEvent.SessionId))
                {
                    _sessions[tabId] = streamEvent.SessionId;
                }
                else if (streamEvent.Type == "token" && !string.IsNullOrEmpty(streamEvent.Text))
                {
                    assistantBuilder.Append(streamEvent.Text);
                    if (assistantEntry is null)
                    {
                        assistantEntry = new ChatEntry
                        {
                            Role = "assistant",
                            Content = assistantBuilder.ToString(),
                            Streaming = true,
                        };
                        history.Add(assistantEntry);
                    }
                    else
                    {
                        assistantEntry.Content = assistantBuilder.ToString();
                    }

                    StateHasChanged();
                }
                else if (streamEvent.Type == "tool_start" && !string.IsNullOrEmpty(streamEvent.ToolName))
                {
                    history.Add(new ChatEntry
                    {
                        Role = "tool",
                        Content = $"Running {streamEvent.ToolName} …",
                        ToolName = streamEvent.ToolName,
                        ToolArguments = streamEvent.ToolArguments,
                        Running = true,
                    });
                    StateHasChanged();
                }
                else if (streamEvent.Type == "tool_end" && !string.IsNullOrEmpty(streamEvent.ToolName))
                {
                    var pending = history.LastOrDefault(entry => entry.Running && entry.ToolName == streamEvent.ToolName);
                    if (pending is not null)
                    {
                        pending.Running = false;
                        pending.Content = $"Ran {streamEvent.ToolName} …";
                        pending.ToolArguments = streamEvent.ToolArguments ?? pending.ToolArguments;
                        pending.ToolResult = streamEvent.ToolResult;
                        StateHasChanged();
                    }
                }
                else if (streamEvent.Type == "error" && !string.IsNullOrEmpty(streamEvent.ErrorMessage))
                {
                    history.Add(new ChatEntry { Role = "error", Content = streamEvent.ErrorMessage });
                    StateHasChanged();
                }
                else if (streamEvent.Type == "done")
                {
                    if (assistantEntry is not null)
                    {
                        assistantEntry.Streaming = false;
                    }

                    RequestScrollToBottom(tabId);
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            history.Add(new ChatEntry { Role = "error", Content = ex.Message });
        }
        finally
        {
            _isSendingByTab[tabId] = false;
            if (assistantEntry is not null)
            {
                assistantEntry.Streaming = false;
            }

            RequestScrollToBottom(tabId);
        }
    }
}
