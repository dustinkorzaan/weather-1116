@page "/presentation"
@using WeatherBlazor.Data
@inject WeatherApiClient WeatherClient

<PageTitle>Weather Razor - Presentation</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudText Typo="Typo.h5" Class="mb-1">Weather Razor</MudText>
    <MudText Typo="Typo.body1"><strong>@helloMessage</strong></MudText>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="my-3">@errorMessage</MudAlert>
    }

    <MudCard Class="my-4" Outlined="true">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">Current AI Weather</MudText>

            <EditForm Model="this" OnValidSubmit="GetCurrentAIWeatherAsync">
                <div class="d-flex flex-wrap align-end gap-4">
                    <MudTextField @bind-Value="location"
                                  Label="Location"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Disabled="isAiWeatherLoading"
                                  Style="flex: 1 1 12rem; max-width: 20rem;" />
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="isAiWeatherLoading"
                               StartIcon="@(isAiWeatherLoading ? null : Icons.Material.Filled.Cloud)">
                        @if (isAiWeatherLoading)
                        {
                            <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        <span>Get Current AI Weather</span>
                    </MudButton>
                </div>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(aiWeatherError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@aiWeatherError</MudAlert>
            }

            @if (aiWeather is not null && !isAiWeatherLoading)
            {
                <div class="mt-4">
                    <MudText Typo="Typo.body1" Class="mb-3">@aiWeather.FullSummary</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption">Temperature F</MudText>
                            <MudText Typo="Typo.body1">@aiWeather.TemperatureF</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption">Wind Speed MPH</MudText>
                            <MudText Typo="Typo.body1">@aiWeather.WindSpeedMPH</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption">Wind Direction</MudText>
                            <MudText Typo="Typo.body1">@aiWeather.WindDirection</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption">Conditions</MudText>
                            <MudText Typo="Typo.body1">@aiWeather.Conditions</MudText>
                        </MudItem>
                    </MudGrid>
                </div>
            }
        </MudCardContent>
    </MudCard>

    <ChatPanel />
</MudContainer>

@code {
    private string helloMessage = "Loading hello message...";
    private string? errorMessage;
    private string location = "Nashville, TN";
    private bool isAiWeatherLoading;
    private string? aiWeatherError;
    private AIWeatherResponse? aiWeather;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var helloResponse = await WeatherClient.GetHelloAsync();
            helloMessage = helloResponse?.RequestResponse ?? "No hello response returned.";
        }
        catch
        {
            helloMessage = "Unable to load hello message from API.";
            errorMessage ??= "Unable to load data from the weather API.";
        }
    }

    private async Task GetCurrentAIWeatherAsync()
    {
        isAiWeatherLoading = true;
        aiWeatherError = null;
        aiWeather = null;

        try
        {
            var trimmed = string.IsNullOrWhiteSpace(location) ? "Nashville, TN" : location.Trim();
            location = trimmed;
            aiWeather = await WeatherClient.GetCurrentAIWeatherAsync(trimmed);
            if (aiWeather is null)
            {
                aiWeatherError = "Unable to load AI weather.";
            }
        }
        catch
        {
            aiWeather = null;
            aiWeatherError = "Unable to load AI weather.";
        }
        finally
        {
            isAiWeatherLoading = false;
        }
    }
}
