@page "/current-ai-weather"
@using System.Globalization
@using WeatherBlazor.Data
@inject WeatherApiClient WeatherClient
@inject NavigationManager Navigation

<PageTitle>Weather Razor - Current AI Weather</PageTitle>

<div class="content-page">
    <FluentCard Class="weather-card">
        <h2 class="section-title">Current AI Weather</h2>

        <FluentTabs @bind-ActiveTabId="ActiveTab">
            @foreach (var tab in _tabs)
            {
                <FluentTab Id="@tab.Id" Label="@tab.Label"></FluentTab>
            }
        </FluentTabs>
        <p class="muted tab-description">@_tabs.First(tab => tab.Id == _activeTab).Description</p>

        <EditForm Model="this" OnValidSubmit="GetCurrentAIWeather" @onsubmit:preventDefault="true">
            <div class="form-row">
                <FluentTextField @bind-Value="location"
                                 Label="Location"
                                 Disabled="isAiWeatherLoading"
                                 Style="flex: 1 1 12rem; max-width: 20rem;" />
                <FluentButton Type="ButtonType.Submit"
                              Appearance="Appearance.Outline"
                              Class="ai-weather-submit"
                              Disabled="isAiWeatherLoading">
                    @if (isAiWeatherLoading)
                    {
                        @* start slot sits beside the label so the button grows wider instead of wrapping. *@
                        <FluentProgressRing Slot="start" Width="16px" Stroke="ProgressStroke.Small" />
                    }
                    Get Current AI Weather
                </FluentButton>
            </div>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(aiWeatherError))
        {
            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false" Class="stack-gap">@aiWeatherError</FluentMessageBar>
        }

        @if (isAiWeatherLoading)
        {
            <p class="stat-label stack-gap">Connecting to Microsoft Foundry...</p>
        }

        @if (aiWeather is not null && !isAiWeatherLoading)
        {
            <div class="weather-results">
                <div class="chat-markdown">@((MarkupString)SafeGfmMarkdown.ToHtml(aiWeather.FullSummary))</div>
                <FluentGrid Spacing="2">
                    <FluentGridItem xs="12" sm="6">
                        <div class="stat-label">Temperature</div>
                        <div>@FormatTemperatureF(aiWeather.TemperatureF)</div>
                    </FluentGridItem>
                    <FluentGridItem xs="12" sm="6">
                        <div class="stat-label">Wind Speed</div>
                        <div>@FormatWindSpeedMph(aiWeather.WindSpeedMPH)</div>
                    </FluentGridItem>
                    <FluentGridItem xs="12" sm="6">
                        <div class="stat-label">Wind Direction</div>
                        <div class="wind-direction">
                            @WeatherGridFormat.FormatWindDirection(aiWeather.WindDirectionSource, aiWeather.WindDirectionSourceDegrees)
                            <span class="wind-direction-arrow"
                                  aria-hidden="true"
                                  style="@($"transform: rotate({WeatherGridFormat.NormalizeSourceDegrees(aiWeather.WindDirectionSourceDegrees)}deg)")">v</span>
                        </div>
                    </FluentGridItem>
                    <FluentGridItem xs="12" sm="6">
                        <div class="stat-label">Conditions</div>
                        <div>@aiWeather.Conditions</div>
                    </FluentGridItem>
                    <FluentGridItem xs="12" sm="6">
                        <div class="stat-label">Lat/Long</div>
                        <div>@FormatLatLong(aiWeather.Latitude, aiWeather.Longitude)</div>
                    </FluentGridItem>
                </FluentGrid>
                @if (aiWeather.RunLogDetails.Count > 0)
                {
                    <div class="weather-grid-wrap" style="margin-top: 1rem;">
                        <table class="weather-grid">
                            <thead>
                                <tr>
                                    <th>Time (UTC)</th><th>Loop</th><th>Message</th><th>Input (tokens)</th><th>Cached (tokens)</th>
                                    <th>Output (tokens)</th><th>Reasoning (tokens)</th><th>Total (tokens)</th><th>Running Total (tokens)</th>
                                    <th>Runtime (ms)</th><th>Loop Runtime (ms)</th><th>Running Total (ms)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in aiWeather.RunLogDetails)
                                {
                                    <tr>
                                        <td>@WeatherGridFormat.FormatRunLogTimestamp(entry.DateTimeUtc)</td>
                                        <td>@entry.LoopNumber</td>
                                        <td>@entry.Message</td>
                                        <td>@WeatherGridFormat.FormatRunLogTokenCount(entry.InputTokenCount)</td>
                                        <td>@WeatherGridFormat.FormatRunLogTokenCount(entry.CachedTokenCount)</td>
                                        <td>@WeatherGridFormat.FormatRunLogTokenCount(entry.OutputTokenCount)</td>
                                        <td>@WeatherGridFormat.FormatRunLogTokenCount(entry.ReasoningTokenCount)</td>
                                        <td>@WeatherGridFormat.FormatRunLogTokenCount(entry.TotalTokenCount)</td>
                                        <td>@WeatherGridFormat.FormatRunLogTokenCount(entry.RunningTotalTokenCount)</td>
                                        <td>@WeatherGridFormat.FormatRunLogMs(entry.RuntimeMs)</td>
                                        <td>@WeatherGridFormat.FormatRunLogMs(entry.LoopRuntimeMs)</td>
                                        <td>@WeatherGridFormat.FormatRunLogMs(entry.RunningTotalMs)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p class="stat-label" style="margin-top: 0.5rem;">Total Runtime: @WeatherGridFormat.FormatRunLogMs(aiWeather.RunLogDetails[^1].RunningTotalMs) ms</p>
                    </div>
                }
            </div>
        }
    </FluentCard>
</div>

@code {
    private sealed record AiWeatherTab(string Id, string Label, string Description);

    private readonly AiWeatherTab[] _tabs =
    [
        new("v3", "V3", "In-process tool loop · Like Foundry Console V3"),
        new("v4", "V4", "Remote MCP tools · Like Foundry Console V4"),
        new("v5", "V5", "Hosted Foundry agent · Like Foundry Console V5"),
    ];

    private string _activeTab = "v3";

    private string ActiveTab
    {
        get => _activeTab;
        set => _activeTab = value;
    }

    private readonly Dictionary<string, string> _locations = new()
    {
        ["v3"] = "Nashville, TN",
        ["v4"] = "Nashville, TN",
        ["v5"] = "Nashville, TN",
    };

    private readonly Dictionary<string, AIWeatherResponse?> _results = new()
    {
        ["v3"] = null,
        ["v4"] = null,
        ["v5"] = null,
    };

    private readonly Dictionary<string, string?> _errors = new()
    {
        ["v3"] = null,
        ["v4"] = null,
        ["v5"] = null,
    };

    private readonly Dictionary<string, bool> _loading = new()
    {
        ["v3"] = false,
        ["v4"] = false,
        ["v5"] = false,
    };

    private string location
    {
        get => _locations[_activeTab];
        set => _locations[_activeTab] = value;
    }

    private AIWeatherResponse? aiWeather => _results[_activeTab];
    private string? aiWeatherError => _errors[_activeTab];
    private bool isAiWeatherLoading => _loading[_activeTab];

    private bool queryHandled;

    [SupplyParameterFromQuery(Name = "location")]
    public string? LocationQuery { get; set; }

    protected override void OnParametersSet()
    {
        if (queryHandled || string.IsNullOrWhiteSpace(LocationQuery))
        {
            return;
        }

        location = LocationQuery.Trim();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || queryHandled || string.IsNullOrWhiteSpace(LocationQuery))
        {
            return;
        }

        // Consume the map-pin query after the first paint. NavigateTo during
        // OnParametersSetAsync throws NavigationException on prerender and
        // skips the auto-submit, leaving the field filled but unsubmitted.
        queryHandled = true;
        await GetCurrentAIWeather();
        Navigation.NavigateTo("/current-ai-weather", replace: true);
    }

    private async Task GetCurrentAIWeather()
    {
        var tab = _activeTab;
        _loading[tab] = true;
        _errors[tab] = null;
        _results[tab] = null;
        StateHasChanged();

        try
        {
            var trimmed = string.IsNullOrWhiteSpace(_locations[tab]) ? "Nashville, TN" : _locations[tab].Trim();
            _locations[tab] = trimmed;

            AIWeatherResponse? response = tab switch
            {
                "v3" => await WeatherClient.GetCurrentAIWeatherV3(trimmed),
                "v4" => await WeatherClient.GetCurrentAIWeatherV4(trimmed),
                "v5" => await WeatherClient.GetCurrentAIWeatherV5(trimmed),
                _ => null,
            };

            if (response is null)
            {
                _errors[tab] = "Unable to load AI weather.";
            }
            else
            {
                _results[tab] = response;
            }
        }
        catch
        {
            _results[tab] = null;
            _errors[tab] = "Unable to load AI weather.";
        }
        finally
        {
            _loading[tab] = false;
        }
    }

    private static string FormatTemperatureF(double value) =>
        string.Create(CultureInfo.InvariantCulture, $"{value} °F");

    private static string FormatWindSpeedMph(double value) =>
        string.Create(CultureInfo.InvariantCulture, $"{value} mph");

    private static string FormatLatLong(double latitude, double longitude) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"{FormatHemisphereDegrees(latitude, "N", "S")}, {FormatHemisphereDegrees(longitude, "E", "W")}");

    private static string FormatHemisphereDegrees(double value, string positiveLabel, string negativeLabel)
    {
        var hemisphere = value >= 0 ? positiveLabel : negativeLabel;
        return string.Create(CultureInfo.InvariantCulture, $"{Math.Abs(value):0.00}° {hemisphere}");
    }
}
