# Copy this file to .env and fill in your values.
# The .env file is loaded automatically at startup via DotNetEnv (Env.TraversePath().Load()).
# Never commit your actual .env file — it is listed in .gitignore.

# Azure AI Foundry project URL for the East US 2 resource (required)
# e.g. https://wx1116-prd-res-eu2.services.ai.azure.com/api/projects/wx1116-prd-prj-eu2
# Obtain this from the Azure portal under your Azure AI Foundry project → Overview.
AZURE_FOUNDRY_PROD_EUS2_PROJ_URL=

# Azure AI Foundry API key for the East US 2 resource (required)
# Obtain this from the Azure portal under your Azure AI Foundry resource → Keys and Endpoint.
AZURE_FOUNDRY_PROD_EUS2_KEY=

# Name of the hosted Foundry Agent to call (optional — defaults to wx1116-agent-default)
# AZURE_FOUNDRY_PROD_EUS2_AGENT_NAME=wx1116-agent-default
