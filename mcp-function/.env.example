# Copy this file to .env and fill in your values.
# Loaded at startup via DotNetEnv (Env.TraversePath().Load()).
# Azure Functions also reads Values from local.settings.json into the environment.
# Never commit your actual .env — it is listed in .gitignore.

# Functions host (optional — local.settings.json already sets these for local runs)
# AzureWebJobsStorage=UseDevelopmentStorage=true
# FUNCTIONS_WORKER_RUNTIME=dotnet-isolated

# Hosting (optional)
# ASPNETCORE_ENVIRONMENT=Development

# MCP webhook auth uses the Functions system key `mcp_extension`
# (x-functions-key header). That key is managed by the Functions host / Azure
# App keys — not a custom appsetting in this project.

# BUILD_NUMBER=
# BUILD_START=
