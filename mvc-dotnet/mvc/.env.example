# Copy this file to .env and fill in your values.
# Loaded at startup via DotNetEnv (Env.TraversePath().Load()).
# Never commit your actual .env — it is listed in .gitignore.

# Hosting (optional — launchSettings.json sets Development + http://localhost:8100)
# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://localhost:8100

# Google Maps JavaScript API key (optional — map shows a setup hint when blank)
# Enable "Maps JavaScript API" in Google Cloud Console, then paste the browser key.
# GOOGLE_MAPS_API_KEY=

# Cross-site navigation links (optional — defaults match local ports)
# UI_REACT_URL=http://localhost:3000
# UI_BLAZOR_URL=http://localhost:8090
# MVC_URL=http://localhost:8100
# API_DOTNET_URL=http://localhost:8080

# WORKER_DOTNET_URL=http://localhost:8130
# MCP_APP_URL=http://localhost:8110
# MCP_FUNCTION_URL=http://localhost:8120

# Hangfire storage (client only — the worker runs the servers).
# When set, Hangfire uses SQL Server storage; when blank, it falls back to
# in-memory storage so the MVC app still runs locally without a database.
# DB_CONNECTION_STRING=

# Current AI Weather (model direct + MCP tools) — required for the AI weather form
# Same variables as Foundry Console V4 / Core GetCurrentAIWeatherHandler.
# e.g. https://wx1116-prd-res-eu2.services.ai.azure.com/api/projects/wx1116-prd-prj-eu2
# or https://wx1116-prd-res-eu2.services.ai.azure.com/openai/v1
# Handler appends /openai/v1 when missing.
# AZURE_FOUNDRY_PROD_EUS2_PROJ_URL=
# AZURE_FOUNDRY_PROD_EUS2_KEY=
# MCP_FUNCTION_KEY=
# MCP_APP_KEY=

# BUILD_NUMBER=
# BUILD_START=
# BUILD_BRANCH_NAME=
