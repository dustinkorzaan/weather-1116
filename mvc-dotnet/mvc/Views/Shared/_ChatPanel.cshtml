<div class="chat-panel">
    <h2 class="section-heading">Chat Clients</h2>
    <p class="chat-lede">
        Four standalone chat tabs: Responses API vs Agent Framework, each with in-process (V3) or MCP (V4) tools.
    </p>

    <div class="chat-tabs" role="tablist" aria-label="Chat client tabs">
        <button type="button" class="chat-tab is-active" data-chat-tab="Chat1a" role="tab" aria-selected="true">Chat1a</button>
        <button type="button" class="chat-tab" data-chat-tab="Chat1b" role="tab" aria-selected="false">Chat1b</button>
        <button type="button" class="chat-tab" data-chat-tab="Chat2a" role="tab" aria-selected="false">Chat2a</button>
        <button type="button" class="chat-tab" data-chat-tab="Chat2b" role="tab" aria-selected="false">Chat2b</button>
    </div>

    <div class="chat-tab-descriptions">
        <p class="chat-tab-description" data-chat-description="Chat1a">In-process · Responses API · Like Foundry Console V3</p>
        <p class="chat-tab-description" data-chat-description="Chat1b" hidden>Remote MCP · Responses API · Like Foundry Console V4</p>
        <p class="chat-tab-description" data-chat-description="Chat2a" hidden>In-process · Agent Framework · Like Foundry Console V3</p>
        <p class="chat-tab-description" data-chat-description="Chat2b" hidden>Remote MCP · Agent Framework · Like Foundry Console V4</p>
    </div>

    <section class="chat-conversation" aria-label="Chat conversation">
        <div id="chat-messages" class="chat-messages" aria-live="polite"></div>
        <form id="chat-form" class="chat-form">
            <label class="sr-only" for="chat-input">Message</label>
            <textarea id="chat-input"
                      class="text-area"
                      rows="3"
                      placeholder="Ask about weather in a city…"></textarea>
            <button id="chat-send"
                    type="submit"
                    class="btn chat-send">Send</button>
        </form>
    </section>
</div>
