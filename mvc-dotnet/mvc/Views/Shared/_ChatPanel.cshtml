<div class="chat-panel">
    <h2 class="section-heading">Chat Clients</h2>
    <p class="chat-lede">
        Five standalone chat tabs: Responses API vs Agent Framework (V3 in-process / V4 MCP), plus Chat3 against a hosted Foundry agent (V5).
    </p>

    <div class="chat-tabs" role="tablist" aria-label="Chat client tabs">
        <button type="button" class="chat-tab is-active" data-chat-tab="Chat1a" role="tab" aria-selected="true">Chat1a</button>
        <button type="button" class="chat-tab" data-chat-tab="Chat1b" role="tab" aria-selected="false">Chat1b</button>
        <button type="button" class="chat-tab" data-chat-tab="Chat2a" role="tab" aria-selected="false">Chat2a</button>
        <button type="button" class="chat-tab" data-chat-tab="Chat2b" role="tab" aria-selected="false">Chat2b</button>
        <button type="button" class="chat-tab" data-chat-tab="Chat3" role="tab" aria-selected="false">Chat3</button>
    </div>

    <div class="chat-tab-descriptions">
        <p class="chat-tab-description" data-chat-description="Chat1a">In-process · Responses API · Like Foundry Console V3</p>
        <p class="chat-tab-description" data-chat-description="Chat1b" hidden>Remote MCP · Responses API · Like Foundry Console V4</p>
        <p class="chat-tab-description" data-chat-description="Chat2a" hidden>In-process · Agent Framework · Like Foundry Console V3</p>
        <p class="chat-tab-description" data-chat-description="Chat2b" hidden>Remote MCP · Agent Framework · Like Foundry Console V4</p>
        <p class="chat-tab-description" data-chat-description="Chat3" hidden>Hosted Foundry agent · Like Foundry Console V5</p>
    </div>

    <section class="chat-conversation chat-window" aria-label="Chat conversation">
        <div class="chat-window-toolbar">
            <button type="button"
                    class="chat-fullscreen-button"
                    data-chat-fullscreen-button
                    aria-label="Enter fullscreen"
                    aria-pressed="false"
                    title="Enter fullscreen">
                <svg data-icon="enter" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 3 21 3 21 9" />
                    <polyline points="9 21 3 21 3 15" />
                    <line x1="21" x2="14" y1="3" y2="10" />
                    <line x1="3" x2="10" y1="21" y2="14" />
                </svg>
                <svg data-icon="exit" hidden xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="4 14 10 14 10 20" />
                    <polyline points="20 10 14 10 14 4" />
                    <line x1="14" x2="21" y1="10" y2="3" />
                    <line x1="3" x2="10" y1="21" y2="14" />
                </svg>
            </button>
        </div>
        <div id="chat-messages" class="chat-messages" aria-live="polite"></div>
        <form id="chat-form" class="chat-form">
            <label class="sr-only" for="chat-input">Message</label>
            <textarea id="chat-input"
                      class="text-area"
                      rows="3"
                      placeholder="Ask about weather in a city…"></textarea>
            <button id="chat-send"
                    type="submit"
                    class="btn chat-send">Send</button>
        </form>
    </section>
</div>
