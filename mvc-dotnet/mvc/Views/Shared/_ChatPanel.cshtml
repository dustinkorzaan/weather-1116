<div class="mb-8">
    <h2 class="mb-2 text-2xl font-semibold text-gray-900">Chat Clients</h2>
    <p class="mb-4 text-gray-600">
        Four standalone chat tabs: Responses API vs Agent Framework, each with in-process (V3) or MCP (V4) tools.
    </p>

    <div class="mb-3 flex flex-wrap gap-2" role="tablist" aria-label="Chat client tabs">
        <button type="button" class="chat-tab rounded-full border border-blue-700 bg-blue-700 px-4 py-1.5 text-sm text-white" data-chat-tab="Chat1a" role="tab" aria-selected="true">Chat1a</button>
        <button type="button" class="chat-tab rounded-full border border-gray-300 bg-white px-4 py-1.5 text-sm text-gray-800" data-chat-tab="Chat1b" role="tab" aria-selected="false">Chat1b</button>
        <button type="button" class="chat-tab rounded-full border border-gray-300 bg-white px-4 py-1.5 text-sm text-gray-800" data-chat-tab="Chat2a" role="tab" aria-selected="false">Chat2a</button>
        <button type="button" class="chat-tab rounded-full border border-gray-300 bg-white px-4 py-1.5 text-sm text-gray-800" data-chat-tab="Chat2b" role="tab" aria-selected="false">Chat2b</button>
    </div>

    <div class="mb-4">
        <p class="chat-tab-description text-gray-700" data-chat-description="Chat1a">Responses API · in-process tools (V3 loop)</p>
        <p class="chat-tab-description hidden text-gray-700" data-chat-description="Chat1b">Responses API · remote MCP tools (V4)</p>
        <p class="chat-tab-description hidden text-gray-700" data-chat-description="Chat2a">Agent Framework · in-process tools</p>
        <p class="chat-tab-description hidden text-gray-700" data-chat-description="Chat2b">Agent Framework · remote MCP tools</p>
    </div>

    <section class="flex min-h-[26rem] flex-col rounded-xl border border-gray-200 bg-white shadow-sm" aria-label="Chat conversation">
        <div id="chat-messages" class="flex max-h-[26rem] flex-1 flex-col gap-3 overflow-y-auto p-4" aria-live="polite"></div>
        <form id="chat-form" class="flex flex-col gap-2 border-t border-gray-200 p-3 sm:flex-row sm:items-end">
            <label class="sr-only" for="chat-input">Message</label>
            <textarea id="chat-input"
                      class="min-h-0 w-full flex-1 resize-y rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none"
                      rows="3"
                      placeholder="Ask about weather in a city…"></textarea>
            <button id="chat-send"
                    type="submit"
                    class="rounded-md bg-blue-700 px-4 py-2 font-medium text-white hover:bg-blue-800 disabled:opacity-60 sm:w-28">Send</button>
        </form>
    </section>
</div>
