@inject IConfiguration Configuration
@{
    var uiReactUrl = Configuration["UI_REACT_URL"] ?? "http://localhost:3000";
    var uiBlazorUrl = Configuration["UI_BLAZOR_URL"] ?? "http://localhost:8090";
    var apiUrl = (Configuration["API_DOTNET_URL"] ?? "http://localhost:8080").TrimEnd('/');
    var apiAboutUrl = $"{apiUrl}/About";
    var workerUrl = (Configuration["WORKER_DOTNET_URL"] ?? "http://localhost:8130").TrimEnd('/');
    var workerHangfireUrl = $"{workerUrl}/hangfire";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111827" />
    <title>@ViewData["Title"] - Weather MVC</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <nav class="site-nav">
            <a class="brand-link" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/logo.svg" alt="Weather logo" class="brand-logo" />
                <span class="brand-title">Weather MVC</span>
            </a>

            <div class="avatar-wrap">
                <button id="avatarMenuButton"
                        type="button"
                        class="avatar-button"
                        aria-haspopup="true"
                        aria-expanded="false"
                        aria-controls="avatarMenu"
                        aria-label="Open user menu">
                    @* Lucide "user" icon (inline so the MVC app needs no icon package). *@
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="avatar-icon" aria-hidden="true" focusable="false">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </button>

                <ul id="avatarMenu"
                    class="avatar-menu"
                    role="menu"
                    aria-labelledby="avatarMenuButton">
                    <li role="none">
                        <button class="menu-item" type="button" role="menuitem">Login/Logout</button>
                    </li>
                    <li role="separator"><hr class="menu-separator" /></li>
                    <li role="none"><a class="menu-item" role="menuitem" href="@uiReactUrl" target="_blank" rel="noopener noreferrer">UI React</a></li>
                    <li role="none"><a class="menu-item" role="menuitem" href="@uiBlazorUrl" target="_blank" rel="noopener noreferrer">UI Blazor</a></li>
                    <li role="none"><a class="menu-item" role="menuitem" href="@apiAboutUrl" target="_blank" rel="noopener noreferrer">API About</a></li>
                    <li role="none"><a class="menu-item" role="menuitem" href="@workerHangfireUrl" target="_blank" rel="noopener noreferrer">Worker Hangfire</a></li>
                    <li role="separator"><hr class="menu-separator" /></li>
                    <li role="none">
                        <a class="menu-item" role="menuitem" href="/hello-world">Hello World</a>
                    </li>
                    <li role="none">
                        <a class="menu-item" role="menuitem" href="/current-ai-weather">Current AI Weather</a>
                    </li>
                    <li role="none">
                        <a class="menu-item" role="menuitem" href="/chat-clients">Chat Clients</a>
                    </li>
                    <li role="separator"><hr class="menu-separator" /></li>
                    <li role="none">
                        <button id="aboutMenuItem" class="menu-item" type="button" role="menuitem">About</button>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <main role="main" class="site-main">
        @RenderBody()
    </main>

    <div id="aboutModal" class="about-modal" role="presentation">
        <div class="about-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="aboutModalLabel">
            <div class="about-dialog-header">
                <h5 id="aboutModalLabel" class="about-dialog-title">About</h5>
                <button id="aboutModalClose" type="button" class="about-close" aria-label="Close">&times;</button>
            </div>
            <div class="about-dialog-body">
                <p id="aboutStatus" class="about-status">
                    <span class="spinner spinner-on-muted" aria-hidden="true"></span>
                    <span>Loading About information...</span>
                </p>
                <div id="aboutTreeContainer" hidden></div>
                <div class="about-links">
                    <a href="@uiReactUrl" target="_blank" rel="noopener noreferrer">UI React</a>
                    <a href="@uiBlazorUrl" target="_blank" rel="noopener noreferrer">UI Blazor</a>
                    <a href="@apiAboutUrl" target="_blank" rel="noopener noreferrer">API About</a>
                    <a href="@workerHangfireUrl" target="_blank" rel="noopener noreferrer">Worker Hangfire</a>
                    <a href="https://github.com/dustinkorzaan/weather-1116" target="_blank" rel="noopener noreferrer">GitHub</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
