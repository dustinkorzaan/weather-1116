@inject IConfiguration Configuration
@{
    var uiReactUrl = Configuration["UI_REACT_URL"] ?? "http://localhost:3000";
    var uiBlazorUrl = Configuration["UI_BLAZOR_URL"] ?? "http://localhost:8090";
    var apiUrl = (Configuration["API_DOTNET_URL"] ?? "http://localhost:8080").TrimEnd('/');
    var apiAboutUrl = $"{apiUrl}/About";
    var workerUrl = (Configuration["WORKER_DOTNET_URL"] ?? "http://localhost:8130").TrimEnd('/');
    var workerHangfireUrl = $"{workerUrl}/hangfire";
    var isMapPage = string.Equals(ViewContext.RouteData.Values["action"] as string, "Index", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <script>
        (function () {
            var key = 'weather-theme';
            var stored;
            try { stored = localStorage.getItem(key); } catch (e) { stored = null; }
            var preference = stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
            var resolved = preference === 'system'
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : preference;
            var root = document.documentElement;
            root.classList.toggle('dark', resolved === 'dark');
            root.setAttribute('data-theme', resolved);
            root.setAttribute('data-theme-preference', preference);
            root.style.colorScheme = resolved;
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) {
                meta.setAttribute('content', resolved === 'dark' ? '#111827' : '#ffffff');
            }
        })();
    </script>
    <title>@ViewData["Title"] - Weather MVC</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <nav class="site-nav">
            <a class="brand-link" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/logo.svg" alt="Weather logo" class="brand-logo" />
                <span class="brand-title">Weather MVC</span>
            </a>

            <div class="header-actions">
            @if (isMapPage)
            {
            <div id="addLocationWrap" class="add-location-wrap">
                <button id="addLocationButton"
                        type="button"
                        class="add-location-button"
                        aria-haspopup="true"
                        aria-expanded="false"
                        aria-controls="addLocationPanel"
                        aria-label="Add location">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14" />
                        <path d="M5 12h14" />
                    </svg>
                </button>
                <div id="addLocationPanel" class="add-location-panel" hidden>
                    <form id="addLocationForm"
                          class="add-location-form"
                          data-geo-url="@Url.Action("Index", "Geo")">
                        <label class="add-location-label" for="addLocationInput">Location</label>
                        <input id="addLocationInput"
                               class="text-input"
                               type="text"
                               value="Nashville, TN"
                               autocomplete="address-level2"
                               placeholder="Nashville, TN" />
                        <button id="addLocationSubmit" class="btn" type="submit">
                            <span id="addLocationSpinner" class="spinner spinner-on-muted" hidden aria-hidden="true"></span>
                            <span class="add-location-submit-label">Add to map</span>
                        </button>
                        <p id="addLocationError" class="form-error" hidden></p>
                    </form>
                </div>
            </div>
            }

            <div class="avatar-wrap">
                <button id="avatarMenuButton"
                        type="button"
                        class="avatar-button"
                        aria-haspopup="true"
                        aria-expanded="false"
                        aria-controls="avatarMenu"
                        aria-label="Open user menu">
                    <img src="~/avatar.svg" alt="" width="20" height="20" class="avatar-icon" />
                </button>

                <ul id="avatarMenu"
                    class="avatar-menu"
                    role="menu"
                    aria-labelledby="avatarMenuButton">
                    <li role="none">
                        <button class="menu-item" type="button" role="menuitem">Login/Logout</button>
                    </li>
                    <li role="separator"><hr class="menu-separator" /></li>
                    <li role="none"><a class="menu-item" role="menuitem" href="@uiReactUrl" target="_blank" rel="noopener noreferrer">UI React</a></li>
                    <li role="none"><a class="menu-item" role="menuitem" href="@uiBlazorUrl" target="_blank" rel="noopener noreferrer">UI Blazor</a></li>
                    <li role="none"><a class="menu-item" role="menuitem" href="@apiAboutUrl" target="_blank" rel="noopener noreferrer">API About</a></li>
                    <li role="none"><a class="menu-item" role="menuitem" href="@workerHangfireUrl" target="_blank" rel="noopener noreferrer">Worker Hangfire</a></li>
                    <li role="separator"><hr class="menu-separator" /></li>
                    <li role="none">
                        <a class="menu-item" role="menuitem" href="/hello-world">Hello World</a>
                    </li>
                    <li role="none">
                        <a class="menu-item" role="menuitem" href="/current-ai-weather">Current AI Weather</a>
                    </li>
                    <li role="none">
                        <a class="menu-item" role="menuitem" href="/chat-clients">Chat Clients</a>
                    </li>
                    <li role="separator"><hr class="menu-separator" /></li>
                    <li role="none">
                        <button class="menu-item" type="button" role="menuitemradio" data-theme-option="light" aria-checked="false">Light</button>
                    </li>
                    <li role="none">
                        <button class="menu-item" type="button" role="menuitemradio" data-theme-option="dark" aria-checked="false">Dark</button>
                    </li>
                    <li role="none">
                        <button class="menu-item" type="button" role="menuitemradio" data-theme-option="system" aria-checked="false">System</button>
                    </li>
                    <li role="separator"><hr class="menu-separator" /></li>
                    <li role="none">
                        <button id="aboutMenuItem" class="menu-item" type="button" role="menuitem">About</button>
                    </li>
                </ul>
            </div>
            </div>
        </nav>
    </header>

    <main role="main" class="site-main">
        @RenderBody()
    </main>

    <div id="aboutModal" class="about-modal" role="presentation">
        <div class="about-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="aboutModalLabel">
            <div class="about-dialog-header">
                <h5 id="aboutModalLabel" class="about-dialog-title">About</h5>
                <button id="aboutModalClose" type="button" class="about-close" aria-label="Close">&times;</button>
            </div>
            <div class="about-dialog-body">
                <p id="aboutStatus" class="about-status">
                    <span class="spinner spinner-on-muted" aria-hidden="true"></span>
                    <span>Loading About information...</span>
                </p>
                <div id="aboutTreeContainer" hidden></div>
                <div class="about-links">
                    <a href="@uiReactUrl" target="_blank" rel="noopener noreferrer">UI React</a>
                    <a href="@uiBlazorUrl" target="_blank" rel="noopener noreferrer">UI Blazor</a>
                    <a href="@apiAboutUrl" target="_blank" rel="noopener noreferrer">API About</a>
                    <a href="@workerHangfireUrl" target="_blank" rel="noopener noreferrer">Worker Hangfire</a>
                    <a href="https://github.com/dustinkorzaan/weather-1116" target="_blank" rel="noopener noreferrer">GitHub</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/addLocation.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
