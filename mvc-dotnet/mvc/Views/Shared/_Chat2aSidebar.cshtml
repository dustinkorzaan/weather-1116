<aside id="chat2a-sidebar" class="chat-sidebar" role="complementary" aria-label="Chat2a" hidden>
    <div class="chat-sidebar-header">
        <h2 class="chat-sidebar-title">Chat2a</h2>
        <button id="chat2a-sidebar-close"
                type="button"
                class="chat-sidebar-close"
                aria-label="Close chat">&times;</button>
    </div>
    <div id="chat2a-sidebar-messages" class="chat-sidebar-messages" aria-live="polite"></div>
    <form id="chat2a-sidebar-form" class="chat-sidebar-form">
        <label class="sr-only" for="chat2a-sidebar-input">Message</label>
        <textarea id="chat2a-sidebar-input"
                  class="text-area"
                  rows="3"
                  placeholder="Ask to add or remove a city…"></textarea>
        <button id="chat2a-sidebar-send"
                type="submit"
                class="btn">Send</button>
    </form>
</aside>
