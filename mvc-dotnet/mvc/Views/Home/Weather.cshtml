@model WeatherModalViewModel
@{
    ViewData["Title"] = Model.Title;
    var tabLabel = WeatherModalViewModel.Tabs.First(t => t.Value == Model.Tab).Label;
    var grid = GridConfig(Model.Tab);

    string TabIconPath(string tab) => tab switch
    {
        "current" => "<path d=\"M12 2l1.8 5.2L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.8L12 2z\"/>",
        "daily-forecast" => "<rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 10h18\"/>",
        "hourly-forecast" => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 3\"/>",
        "every-15-forecast" => "<path d=\"M6 2h12M6 22h12M6 2c0 5 4 6 6 8-2 2-6 3-6 8M18 2c0 5-4 6-6 8 2 2 6 3 6 8\"/>",
        _ => "<path d=\"M3 12a9 9 0 1 0 3-6.7\"/><path d=\"M3 4v5h5\"/><path d=\"M12 7v5l3 3\"/>",
    };

    (string[] Headers, string Endpoint, string Resolution, string Field, bool Reverse) GridConfig(string tab) => tab switch
    {
        "daily-forecast" => (["Date", "High", "Low", "Precip", "Wind Speed", "Wind Direction"], "/Forecast", "Daily", "daily", false),
        "hourly-forecast" => (["Date", "Time", "Temp", "Precip", "Wind Speed", "Wind Direction"], "/Forecast", "Hourly", "hourly", false),
        "every-15-forecast" => (["Date", "Time", "Temp", "Precip", "Wind Speed", "Wind Direction"], "/Forecast", "FifteenMinutes", "minutely15", false),
        "daily-history" => (["Date", "High", "Low", "Precip", "Wind Speed", "Wind Direction"], "/History", "Daily", "daily", true),
        "hourly-history" => (["Date", "Time", "Temp", "Precip", "Wind Speed", "Wind Direction"], "/History", "Hourly", "hourly", true),
        _ => ([], "", "", "", false),
    };
}

<div class="weather-modal-overlay">
    <div class="weather-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="weatherModalTitle">
        <div class="weather-modal-header">
            <h1 id="weatherModalTitle" class="weather-modal-title">@Model.Title</h1>
            <a class="weather-modal-close" href="@Url.Action("Index", "Home")" aria-label="Close">&times;</a>
        </div>

        <nav class="weather-modal-tabs" aria-label="Weather views">
            @foreach (var (value, label) in WeatherModalViewModel.Tabs)
            {
                var isActive = value == Model.Tab;
                var href = Url.Action("Weather", "Home", new { name = Model.Name, lat = Model.Latitude, lng = Model.Longitude, tab = value });
                <a class="@(isActive ? "weather-modal-tab is-active" : "weather-modal-tab")"
                   href="@href"
                   title="@label"
                   aria-label="@label"
                   aria-current="@(isActive ? "page" : null)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(TabIconPath(value))</svg>
                    <span class="weather-modal-tab-label">@label</span>
                </a>
            }
        </nav>

        <div class="weather-modal-content">
            @if (Model.Tab == "current")
            {
                <section aria-labelledby="weatherModalCurrentHeading">
                    <div class="weather-modal-tab-heading">
                        <h2 id="weatherModalCurrentHeading" class="section-heading">Current AI Weather</h2>
                        <button id="weatherModalRefresh" type="button" class="weather-modal-refresh" aria-label="Refresh Current AI Weather">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                                <path d="M21 3v6h-6" />
                            </svg>
                        </button>
                    </div>
                    <p id="weatherModalError" class="form-error" hidden></p>
                    <div id="weatherModalResults" class="weather-results" hidden>
                        <div id="weatherModalSummary" class="weather-summary chat-markdown"></div>
                        <dl class="weather-stats">
                            <div class="weather-stat">
                                <dt>Temperature</dt>
                                <dd id="weatherModalTemperature"></dd>
                            </div>
                            <div class="weather-stat">
                                <dt>Wind Speed</dt>
                                <dd id="weatherModalWindSpeed"></dd>
                            </div>
                            <div class="weather-stat">
                                <dt>Wind Direction</dt>
                                <dd id="weatherModalWindDirection" class="wind-direction"></dd>
                            </div>
                            <div class="weather-stat">
                                <dt>Conditions</dt>
                                <dd id="weatherModalConditions"></dd>
                            </div>
                            <div class="weather-stat">
                                <dt>Lat/Long</dt>
                                <dd id="weatherModalLatLong"></dd>
                            </div>
                        </dl>
                    </div>
                </section>
            }
            else
            {
                <section aria-labelledby="weatherModalGridHeading">
                    <div class="weather-modal-tab-heading">
                        <h2 id="weatherModalGridHeading" class="section-heading">@tabLabel</h2>
                        <button id="weatherModalGridRefresh" type="button" class="weather-modal-refresh" aria-label="Refresh @tabLabel">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                                <path d="M21 3v6h-6" />
                            </svg>
                        </button>
                    </div>
                    <p id="weatherModalGridError" class="form-error" hidden></p>
                    <div id="weatherModalGridWrap" class="weather-modal-grid-wrap" hidden>
                        <table class="weather-modal-grid">
                            <thead>
                                <tr>
                                    @foreach (var header in grid.Headers)
                                    {
                                        <th>@header</th>
                                    }
                                </tr>
                            </thead>
                            <tbody id="weatherModalGridBody"></tbody>
                        </table>
                    </div>
                </section>
            }
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.Tab == "current")
    {
        <script src="~/js/lib/marked.min.js" asp-append-version="true"></script>
        <script src="~/js/lib/purify.min.js" asp-append-version="true"></script>
        <script src="~/js/markdown/safeGfmMarkdown.js" asp-append-version="true"></script>
        <script src="~/js/weatherModal.js" asp-append-version="true"></script>
        <script>
            weatherModal.init({
                location: @Json.Serialize(Model.LocationQuery),
                endpoint: '@Url.Action("GetCurrentAIWeather", "Home")',
                refreshButtonId: 'weatherModalRefresh',
                errorId: 'weatherModalError',
                resultsId: 'weatherModalResults',
                summaryId: 'weatherModalSummary',
                temperatureId: 'weatherModalTemperature',
                windSpeedId: 'weatherModalWindSpeed',
                windDirectionId: 'weatherModalWindDirection',
                conditionsId: 'weatherModalConditions',
                latLongId: 'weatherModalLatLong'
            });
        </script>
    }
    else
    {
        <script src="~/js/weatherModalGrids.js" asp-append-version="true"></script>
        <script>
            weatherModalGrids.init({
                refreshButtonId: 'weatherModalGridRefresh',
                errorId: 'weatherModalGridError',
                wrapId: 'weatherModalGridWrap',
                bodyId: 'weatherModalGridBody',
                endpoint: @Json.Serialize(grid.Endpoint),
                resolution: @Json.Serialize(grid.Resolution),
                field: @Json.Serialize(grid.Field),
                reverse: @Json.Serialize(grid.Reverse),
                lat: @Json.Serialize(Model.Latitude),
                lng: @Json.Serialize(Model.Longitude),
                errorMessage: @Json.Serialize($"Unable to load {tabLabel}.")
            });
        </script>
    }
    <script>
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                window.location.assign('@Url.Action("Index", "Home")');
            }
        });
    </script>
}
