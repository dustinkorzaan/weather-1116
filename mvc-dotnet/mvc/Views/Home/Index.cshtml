@using System.Text.Json
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Home";
    var mapsApiKey = Configuration["GOOGLE_MAPS_API_KEY"] ?? "";
    var mapCities = new[]
    {
        new { id = "nyc", name = "New York, NY", lat = 40.7128, lng = -74.006 },
        new { id = "toronto", name = "Toronto, ON", lat = 43.6532, lng = -79.3832 },
        new { id = "atlanta", name = "Atlanta, GA", lat = 33.749, lng = -84.388 },
        new { id = "charlotte", name = "Charlotte, NC", lat = 35.2271, lng = -80.8431 },
    };
    var citiesJson = JsonSerializer.Serialize(mapCities);
}

<section class="map-section" aria-label="Map">
    @if (string.IsNullOrWhiteSpace(mapsApiKey))
    {
        <p class="map-key-hint">
            Set <code>GOOGLE_MAPS_API_KEY</code> in appsettings (or env <code>GOOGLE_MAPS_API_KEY</code>) to enable Google Maps.
        </p>
    }
    <div class="map-canvas-wrap">
        <div id="weather-map"
             data-status="@(string.IsNullOrWhiteSpace(mapsApiKey) ? "missing-key" : "loading")"></div>
        @if (string.IsNullOrWhiteSpace(mapsApiKey))
        {
            <div class="weather-map-pin-card-preview" role="dialog" aria-label="Atlanta, GA">
                <div class="weather-map-pin-card">
                    <div class="weather-map-pin-card-header">
                        <div class="weather-map-pin-card-name">Atlanta, GA</div>
                        <span class="weather-map-pin-card-delete" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                        </span>
                    </div>
                    <button type="button" class="weather-map-pin-card-button">Get Current AI Weather</button>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/weatherMap.js" asp-append-version="true"></script>
    @if (!string.IsNullOrWhiteSpace(mapsApiKey))
    {
        <script>
            weatherMap.init('weather-map', @Json.Serialize(mapsApiKey), @Html.Raw(citiesJson))
                .catch(function () {
                    var el = document.getElementById('weather-map');
                    if (el) {
                        el.setAttribute('data-status', 'error');
                    }
                });
        </script>
    }
}
