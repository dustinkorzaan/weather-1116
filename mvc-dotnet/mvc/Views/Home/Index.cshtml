@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Home";
    var mapsApiKey = Configuration["GOOGLE_MAPS_API_KEY"] ?? "";
}

@* The Chat2a sidebar docks beside the map (below it under 640px), so the map narrows instead of being covered. *@
<section class="map-section" aria-label="Map">
    <div class="map-canvas-wrap">
        @if (string.IsNullOrWhiteSpace(mapsApiKey))
        {
            <p class="map-key-hint">
                Set <code>GOOGLE_MAPS_API_KEY</code> in appsettings (or env <code>GOOGLE_MAPS_API_KEY</code>) to enable Google Maps.
            </p>
        }
        <div id="weather-map"
             data-status="@(string.IsNullOrWhiteSpace(mapsApiKey) ? "missing-key" : "loading")"
             data-get-location-url="@Url.Action("GetLocation", "Geo")"></div>
    </div>
    <partial name="_Chat2aSidebar" />
</section>

@section Scripts {
    <script src="~/js/weatherMap.js" asp-append-version="true"></script>
    <script src="~/js/lib/marked.min.js" asp-append-version="true"></script>
    <script src="~/js/lib/purify.min.js" asp-append-version="true"></script>
    <script src="~/js/markdown/safeGfmMarkdown.js" asp-append-version="true"></script>
    <script src="~/js/chatRender.js" asp-append-version="true"></script>
    <script src="~/js/chatSidebar.js" asp-append-version="true"></script>
    @if (!string.IsNullOrWhiteSpace(mapsApiKey))
    {
        <script>
            // weatherMap.init loads the map immediately and fetches /User pins alongside it.
            weatherMap.init('weather-map', @Json.Serialize(mapsApiKey)).catch(function () {
                var el = document.getElementById('weather-map');
                if (el) {
                    el.setAttribute('data-status', 'error');
                }
            });
        </script>
    }
}
