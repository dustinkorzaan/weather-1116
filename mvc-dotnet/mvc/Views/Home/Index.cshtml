@using System.Text.Json
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Home";
    var helloResponse = ViewData["HelloResponse"] as string;
    var mapsApiKey = Configuration["GOOGLE_MAPS_API_KEY"] ?? "";
    var mapCities = new[]
    {
        new { id = "nyc", name = "New York", lat = 40.7128, lng = -74.006 },
        new { id = "toronto", name = "Toronto", lat = 43.6532, lng = -79.3832 },
        new { id = "atlanta", name = "Atlanta", lat = 33.749, lng = -84.388 },
        new { id = "charlotte", name = "Charlotte", lat = 35.2271, lng = -80.8431 },
    };
    var citiesJson = JsonSerializer.Serialize(mapCities);
}

@if (!string.IsNullOrWhiteSpace(helloResponse))
{
    <p class="lead">@helloResponse</p>
}

<section class="ai-weather-section" aria-label="Current AI weather">
    <form id="ai-weather-form" class="ai-weather-form">
        <label class="ai-weather-label" for="ai-weather-location">Location:</label>
        <input id="ai-weather-location"
               class="form-control ai-weather-input"
               type="text"
               value="Nashville, TN"
               autocomplete="address-level2" />
        <button id="ai-weather-button" type="submit" class="btn btn-primary ai-weather-button">
            <span id="ai-weather-spinner" class="ai-weather-spinner" hidden aria-hidden="true"></span>
            <span>Get Current AI Weather</span>
        </button>
    </form>
    <p id="ai-weather-error" class="text-danger" hidden></p>
    <div id="ai-weather-results" class="ai-weather-results" hidden>
        <p id="ai-weather-summary" class="ai-weather-summary"></p>
        <dl class="ai-weather-stats">
            <div class="ai-weather-stat">
                <dt>Temperature F</dt>
                <dd id="ai-weather-temperature"></dd>
            </div>
            <div class="ai-weather-stat">
                <dt>Wind Speed MPH</dt>
                <dd id="ai-weather-wind-speed"></dd>
            </div>
            <div class="ai-weather-stat">
                <dt>Wind Direction</dt>
                <dd id="ai-weather-wind-direction"></dd>
            </div>
            <div class="ai-weather-stat">
                <dt>Conditions</dt>
                <dd id="ai-weather-conditions"></dd>
            </div>
        </dl>
    </div>
</section>

<section class="weather-map-section" aria-label="Map">
    @if (string.IsNullOrWhiteSpace(mapsApiKey))
    {
        <p class="text-danger">
            Set <code>GOOGLE_MAPS_API_KEY</code> in appsettings (or env <code>GOOGLE_MAPS_API_KEY</code>) to enable Google Maps.
        </p>
    }
    <div id="weather-map" class="weather-map" data-status="@(string.IsNullOrWhiteSpace(mapsApiKey) ? "missing-key" : "loading")"></div>
</section>

<partial name="_ChatPanel" />

@section Styles {
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/currentAIWeather.js" asp-append-version="true"></script>
    <script src="~/js/weatherMap.js" asp-append-version="true"></script>
    <script src="~/js/chatClient.js" asp-append-version="true"></script>
    <script>
        currentAIWeather.init({
            formId: 'ai-weather-form',
            locationId: 'ai-weather-location',
            buttonId: 'ai-weather-button',
            spinnerId: 'ai-weather-spinner',
            errorId: 'ai-weather-error',
            resultsId: 'ai-weather-results',
            summaryId: 'ai-weather-summary',
            temperatureId: 'ai-weather-temperature',
            windSpeedId: 'ai-weather-wind-speed',
            windDirectionId: 'ai-weather-wind-direction',
            conditionsId: 'ai-weather-conditions',
            endpoint: '@Url.Action("GetCurrentAIWeather", "Home")'
        });
    </script>
    @if (!string.IsNullOrWhiteSpace(mapsApiKey))
    {
        <script>
            weatherMap.init('weather-map', @Json.Serialize(mapsApiKey), @Html.Raw(citiesJson))
                .catch(function () {
                    var el = document.getElementById('weather-map');
                    if (el) {
                        el.setAttribute('data-status', 'error');
                    }
                });
        </script>
    }
}
