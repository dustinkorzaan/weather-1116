# Copy this file to .env and fill in your values.
# Loaded at startup via DotNetEnv (Env.TraversePath().Load()).
# ASP.NET Core nested keys use double-underscore (__).
# Never commit your actual .env — it is listed in .gitignore.

# Hosting (optional — launchSettings.json sets Development + http://localhost:8100)
# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://localhost:8100

# Google Maps JavaScript API key (optional — map shows a setup hint when blank)
# Enable "Maps JavaScript API" in Google Cloud Console, then paste the browser key.
# GOOGLE_MAPS_API_KEY=

# Cross-site navigation links (optional — defaults match local ports)
# UI_REACT_URL=http://localhost:3000
# UI_BLAZOR_URL=http://localhost:8090
# MVC_URL=http://localhost:8100
# API_DOTNET_URL=http://localhost:8080

# MCP service base URLs — /About is appended in code for the About tree
# MCP_DOTNET_URL=http://localhost:8110
# MCP_FUNCTION_URL=http://localhost:8120

# Current AI Weather (Foundry Agent) — required for the AI weather form
# Same variables as Foundry Console V4 / Core GetCurrentAIWeatherHandler.
# AZURE_FOUNDRY_PROD_EUS2_PROJ_URL=https://wx1116-prd-res-eu2.services.ai.azure.com/api/projects/wx1116-prd-prj-eu2
# AZURE_FOUNDRY_PROD_EUS2_KEY=
# AZURE_FOUNDRY_PROD_EUS2_AGENT_NAME=wx1116-agent-default

# Build metadata shown on About (optional — set by CI/CD)
# BUILD_NUMBER=
# BUILD_START=
