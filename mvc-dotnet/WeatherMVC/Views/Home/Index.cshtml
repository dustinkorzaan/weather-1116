@using System.Text.Json
@inject IConfiguration Configuration
@model Core.demo.forecast.WeatherForecast[]
@{
    ViewData["Title"] = "Home";
    var helloResponse = ViewData["HelloResponse"] as string;
    var mapsApiKey = Configuration["GoogleMaps:ApiKey"] ?? "";
    var mapCities = new[]
    {
        new { id = "nyc", name = "New York", lat = 40.7128, lng = -74.006 },
        new { id = "toronto", name = "Toronto", lat = 43.6532, lng = -79.3832 },
        new { id = "atlanta", name = "Atlanta", lat = 33.749, lng = -84.388 },
        new { id = "charlotte", name = "Charlotte", lat = 35.2271, lng = -80.8431 },
    };
    var citiesJson = JsonSerializer.Serialize(mapCities);
}

@if (!string.IsNullOrWhiteSpace(helloResponse))
{
    <p class="lead">@helloResponse</p>
}

<section class="weather-map-section" aria-label="City map">
    <h2>City map</h2>
    @if (string.IsNullOrWhiteSpace(mapsApiKey))
    {
        <p class="text-danger">
            Set <code>GoogleMaps:ApiKey</code> in appsettings (or env <code>GoogleMaps__ApiKey</code>) to enable Google Maps.
        </p>
    }
    <div id="weather-map" class="weather-map" data-status="@(string.IsNullOrWhiteSpace(mapsApiKey) ? "missing-key" : "loading")"></div>
</section>

<h2>Weather forecast</h2>

@if (Model == null || Model.Length == 0)
{
    <p><em>No forecast data available.</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Temp. (C)</th>
                    <th>Temp. (F)</th>
                    <th>Summary</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var forecast in Model)
                {
                    <tr>
                        <td>@forecast.Date.ToShortDateString()</td>
                        <td>@((forecast.TemperatureK - 273.15).ToString("0.##"))</td>
                        <td>@((((forecast.TemperatureK - 273.15) * 9.0 / 5.0) + 32.0).ToString("0.##"))</td>
                        <td>@forecast.Summary</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script src="~/js/weatherMap.js" asp-append-version="true"></script>
    @if (!string.IsNullOrWhiteSpace(mapsApiKey))
    {
        <script>
            weatherMap.init('weather-map', @Json.Serialize(mapsApiKey), @Html.Raw(citiesJson))
                .catch(function () {
                    var el = document.getElementById('weather-map');
                    if (el) {
                        el.setAttribute('data-status', 'error');
                    }
                });
        </script>
    }
}
