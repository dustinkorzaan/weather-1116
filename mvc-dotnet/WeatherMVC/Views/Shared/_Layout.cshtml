@inject IConfiguration Configuration
@{
    var uiReactUrl = Configuration["UI_REACT_URL"] ?? "http://localhost:3000";
    var uiBlazorUrl = Configuration["UI_BLAZOR_URL"] ?? "http://localhost:8090";
    var apiUrl = (Configuration["API_DOTNET_URL"] ?? "http://localhost:8080").TrimEnd('/');
    var apiAboutUrl = $"{apiUrl}/About";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#185ca9" />
    <title>@ViewData["Title"] - Weather MVC</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WeatherMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid px-3 px-sm-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/logo.svg" alt="Weather logo" class="site-logo" />
                    <span class="fw-semibold text-dark">Weather MVC</span>
                </a>
                <div class="dropdown avatar-menu ms-auto">
                    <button class="btn avatar-button" type="button" id="avatarMenuButton" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Open user menu">
                        <svg viewBox="0 0 24 24" class="avatar-icon" aria-hidden="true" focusable="false">
                            <circle cx="12" cy="8" r="4" fill="currentColor" />
                            <path d="M4 20c0-4.418 3.582-8 8-8s8 3.582 8 8" fill="currentColor" />
                        </svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="avatarMenuButton">
                        <li><a class="dropdown-item" href="@uiReactUrl" target="_blank" rel="noopener noreferrer">UI React</a></li>
                        <li><a class="dropdown-item" href="@uiBlazorUrl" target="_blank" rel="noopener noreferrer">UI Blazor</a></li>
                        <li><a class="dropdown-item" href="@apiAboutUrl" target="_blank" rel="noopener noreferrer">API About</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#aboutModal">About</button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="aboutModal" tabindex="-1" aria-labelledby="aboutModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="aboutModalLabel">About</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="about-status" id="aboutStatus">Loading About information...</p>
                    <div id="aboutTreeContainer" class="d-none"></div>
                    <div class="site-links-footer">
                        <a href="@uiReactUrl" target="_blank" rel="noopener noreferrer">UI React</a>
                        <a href="@uiBlazorUrl" target="_blank" rel="noopener noreferrer">UI Blazor</a>
                        <a href="@apiAboutUrl" target="_blank" rel="noopener noreferrer">API About</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
