<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Core.Tests project lives under ../core.tests/; keep its sources out of the library build. -->
    <Compile Remove="../core.tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Azure.AI.Projects" Version="3.0.0-beta.1" />
    <!-- Chat2a/Chat2b use ResponsesClient.AsAIAgent from Microsoft.Agents.AI.OpenAI.
         Keep this train together: a lone ME.AI bump (PR #223, 10.9.0) previously
         unified Abstractions ahead of Microsoft.Extensions.AI.OpenAI 10.4.0 and
         broke both tabs. Direct-pin Abstractions and the OpenAI adapter so a
         transitive bump cannot reintroduce the mix. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.20.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.20.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <!-- Hangfire.Core resolves Newtonsoft.Json 11.0.1, which carries a high severity
         advisory (GHSA-5crp-9r3c-p9vr). Pin the patched version for Core and its consumers. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Microsoft.Extensions.AI.OpenAI 10.9.0 declares OpenAI [2.12.0, 2.13.0);
         2.13.0 itself resolves but triggers NU1608. Pin to 2.12.0, the top of
         that declared range, until the adapter widens it. -->
    <PackageReference Include="OpenAI" Version="2.12.0" />
    <ProjectReference Include="..\..\cqmediator-dotnet\cqmediator\CQMediator.csproj" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Core.Tests" />
  </ItemGroup>

</Project>
