# Copy this file to .env and fill in your values.
# Loaded at startup via DotNetEnv (Env.TraversePath().Load()).
# Never commit your actual .env — it is listed in .gitignore.

# Azure AI Foundry unified OpenAI endpoint (required)
# https://<account>.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_PROD_PROJ_URL=
# Azure portal → your Azure AI Foundry / OpenAI resource → Keys and Endpoint.
AZURE_FOUNDRY_PROD_KEY=

# McpSrvFuncApp key (required — sent as x-functions-key)
# Azure portal → wx1116-prod-mcp-srv-func-app → App keys → System keys → mcp_extension.
# Prod URL: https://wx1116-prod-mcp-srv-func-app.azurewebsites.net
MCP_SRV_FUNC_APP_KEY=

# McpSrvAppService key (required — sent as Authorization: Bearer <key>)
# Same value as MCP_SRV_APP_SERVICE_KEY on wx1116-prod-mcp-srv-app-service.
# Prod URL: https://wx1116-prod-mcp-srv-app-service.azurewebsites.net
MCP_SRV_APP_SERVICE_KEY=
