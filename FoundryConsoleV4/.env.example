# Copy this file to .env and fill in your values.
# Loaded at startup via DotNetEnv (Env.TraversePath().Load()).
# Never commit your actual .env — it is listed in .gitignore.

# Azure AI Foundry project URL (required)
# e.g. https://wx1116-prd-res-eu2.services.ai.azure.com/api/projects/wx1116-prd-prj-eu2
# Azure portal → Azure AI Foundry project → Overview.
AZURE_FOUNDRY_PROD_EUS2_PROJ_URL=

# Azure AI Foundry API key (required)
# Azure portal → Azure AI Foundry / OpenAI resource → Keys and Endpoint.
AZURE_FOUNDRY_PROD_EUS2_KEY=

# Hosted Foundry Agent name (optional — defaults to wx1116-agent-default)
# AZURE_FOUNDRY_PROD_EUS2_AGENT_NAME=wx1116-agent-default
