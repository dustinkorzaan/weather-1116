# Copy this file to .env and fill in your values.
# Loaded at startup via DotNetEnv (Env.TraversePath().Load()).
# Never commit your actual .env — it is listed in .gitignore.

# Azure AI Foundry API key (required)
# Used against the hardcoded unified AI services endpoint in Program.cs.
# Azure portal → your Azure AI Foundry / OpenAI resource → Keys and Endpoint.
AZURE_FOUNDRY_PROD_EUS2_KEY=

# McpSrvFuncApp key (required — sent as x-functions-key)
# Azure portal → weather1116-prod-mcp-srv-func-app → App keys → System keys → mcp_extension.
# Prod URL: https://weather1116-prod-mcp-srv-func-app-b3a6f0cmhqcya3bw.westus2-01.azurewebsites.net
MCP_SRV_FUNC_APP_KEY=

# McpSrvAppService key (required — sent as Authorization: Bearer <key>)
# Same value as MCP_SRV_APP_SERVICE_KEY on weather1116-prod-mcp-srv-app-service.
# Prod URL: https://weather1116-prod-mcp-srv-app-service-gdaef6e5cndqb3du.westus2-01.azurewebsites.net
MCP_SRV_APP_SERVICE_KEY=
