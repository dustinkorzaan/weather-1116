{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "2826444761282336092"
    }
  },
  "parameters": {
    "name": {
      "type": "string",
      "metadata": {
        "description": "App Service name, e.g. wx1116-prod-api."
      }
    },
    "location": {
      "type": "string"
    },
    "appServicePlanId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the shared App Service Plan."
      }
    },
    "userAssignedIdentityId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of this app's dedicated User-Assigned Managed Identity."
      }
    },
    "userAssignedIdentityClientId": {
      "type": "string",
      "metadata": {
        "description": "Client ID of this app's dedicated User-Assigned Managed Identity."
      }
    },
    "setAzureClientId": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Whether to set AZURE_CLIENT_ID so DefaultAzureCredential picks this UAMI."
      }
    },
    "clientAffinityEnabled": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable client affinity (ARR session-affinity cookie). true for Blazor Server (SignalR needs sticky sessions); false for everything else so a plan scale-out does not skew load."
      }
    },
    "appInsightsConnectionString": {
      "type": "string"
    }
  },
  "variables": {
    "baseAppSettings": [
      {
        "name": "ASPNETCORE_ENVIRONMENT",
        "value": "Production"
      },
      {
        "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
        "value": "[parameters('appInsightsConnectionString')]"
      },
      {
        "name": "WEBSITE_RUN_FROM_PACKAGE",
        "value": "1"
      }
    ],
    "clientIdAppSetting": [
      {
        "name": "AZURE_CLIENT_ID",
        "value": "[parameters('userAssignedIdentityClientId')]"
      }
    ],
    "appSettings": "[if(parameters('setAzureClientId'), concat(variables('baseAppSettings'), variables('clientIdAppSetting')), variables('baseAppSettings'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('userAssignedIdentityId'))]": {}
        }
      },
      "properties": {
        "serverFarmId": "[parameters('appServicePlanId')]",
        "httpsOnly": true,
        "clientAffinityEnabled": "[parameters('clientAffinityEnabled')]",
        "siteConfig": {
          "linuxFxVersion": "DOTNETCORE|10",
          "alwaysOn": true,
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "appSettings": "[variables('appSettings')]"
        }
      }
    }
  ],
  "outputs": {
    "id": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', parameters('name'))]"
    },
    "name": {
      "type": "string",
      "value": "[parameters('name')]"
    },
    "defaultHostname": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('name')), '2023-12-01').defaultHostName]"
    }
  }
}