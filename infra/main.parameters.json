{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME=prod}"
    },
    "location": {
      "value": "${AZURE_LOCATION=eastus2}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP_NAME=wx1116-prod-rg}"
    },
    "githubActionsIdentityName": {
      "value": "${GITHUB_ACTIONS_IDENTITY_NAME=wx1116-prod-github-actions-mi}"
    },
    "storageAccountName": {
      "value": "${STORAGE_ACCOUNT_NAME=wx1116prodblob}"
    },
    "postgresAdministratorLogin": {
      "value": "${POSTGRES_ADMINISTRATOR_LOGIN}"
    },
    "existingContainerAppKeys": {
      "value": "${EXISTING_CONTAINER_APP_KEYS}"
    },
    "mcpSrvAppServiceKey": {
      "value": "${MCP_SRV_APP_SERVICE_KEY}"
    },
    "mcpSrvFuncAppKey": {
      "value": "${MCP_SRV_FUNC_APP_KEY}"
    }
  }
}
