# Copy this file to .env and fill in your value.
# The .env file is loaded automatically at startup via DotNetEnv (Env.TraversePath().Load()).
# Never commit your actual .env file — it is listed in .gitignore.

# Azure AI Foundry API key for the East US 2 resource (cognitiveservices endpoint)
# Obtain this from the Azure portal under your Azure AI Foundry resource → Keys and Endpoint.
AZURE_FOUNDRY_PROD_EUS2_KEY=
