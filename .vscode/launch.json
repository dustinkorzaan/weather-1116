{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Run All",
            "presentation": {
				"group": "maingroup",
				"order": 1
			},
            "configurations": [
                "WeatherAPI",
                "WeatherBlazor",
                "WeatherMVC",
                "React"
            ]
        }
    ],
    "configurations": [
        {
            "name": "WeatherAPI",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build weatherapi",
            "program": "${workspaceFolder}/api-dotnet/WeatherAPI/bin/Debug/net10.0/WeatherAPI.dll",
            "args": [],
            "cwd": "${workspaceFolder}/api-dotnet/WeatherAPI",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/scalar"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "WeatherBlazor",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build weatherblazor",
            "program": "${workspaceFolder}/ui-blazor/WeatherBlazor/bin/Debug/net10.0/WeatherBlazor.dll",
            "args": [],
            "cwd": "${workspaceFolder}/ui-blazor/WeatherBlazor",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "WeatherMVC",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build weathermvc",
            "program": "${workspaceFolder}/mvc-dotnet/WeatherMVC/bin/Debug/net10.0/WeatherMVC.dll",
            "args": [],
            "cwd": "${workspaceFolder}/mvc-dotnet/WeatherMVC",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/mvc-dotnet/WeatherMVC/Views"
            }
        },
        {
            "name": "React",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm start",
            "cwd": "${workspaceFolder}/ui-react",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Local:\\s+https?://localhost:(\\d+)",
                "uriFormat": "http://localhost:%s"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}