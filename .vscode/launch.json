{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Run All",
            "presentation": {
				"group": "maingroup",
				"order": 1
			},
            "configurations": [
                "WeatherAPI",
                "WeatherBlazor",
                "WeatherMVC",
                "React"
            ]
        }
    ],
    "configurations": [
        {
            "name": "WeatherAPI",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build weatherapi",
            "program": "${workspaceFolder}/api-dotnet/WeatherAPI/bin/Debug/net10.0/WeatherAPI.dll",
            "args": [],
            "cwd": "${workspaceFolder}/api-dotnet/WeatherAPI",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/weatherforecast"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "WeatherBlazor",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build weatherblazor",
            "program": "${workspaceFolder}/ui-blazor/WeatherBlazor/bin/Debug/net10.0/WeatherBlazor.dll",
            "args": [],
            "cwd": "${workspaceFolder}/ui-blazor/WeatherBlazor",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "WeatherMVC",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build weathermvc",
            "program": "${workspaceFolder}/mvc-dotnet/WeatherMVC/bin/Debug/net10.0/WeatherMVC.dll",
            "args": [],
            "cwd": "${workspaceFolder}/mvc-dotnet/WeatherMVC",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/mvc-dotnet/WeatherMVC/Views"
            }
        },
        {
            "name": "React",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm start",
            "cwd": "${workspaceFolder}/ui-react",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Local:\\s+https?://localhost:(\\d+)",
                "uriFormat": "http://localhost:%s"
            }
        },
        {
            "name": "WeatherMcpDotNet",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build mcp dotnet",
            "program": "${workspaceFolder}/mcp-dotnet/bin/Debug/net10.0/WeatherMcpDotNet.dll",
            "args": [],
            "cwd": "${workspaceFolder}/mcp-dotnet",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/health"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "WeatherMcpFunction",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:azureFunctions.pickProcess}"
        },
        {
            "name": "Foundry Console V1 Model Direct Legacy Cognitive Services Endpoint",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build foundry console v1",
            "program": "${workspaceFolder}/FoundryConsoleV1ModelDirectLegacyCognitiveServicesEndpoint/bin/Debug/net10.0/WeatherFoundryConsole.dll",
            "args": [],
            "cwd": "${workspaceFolder}/FoundryConsoleV1ModelDirectLegacyCognitiveServicesEndpoint",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Foundry Console V2 Model Direct New Unified AI Services",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build foundry console v2",
            "program": "${workspaceFolder}/FoundryConsoleV2ModelDirectNewUnifiedAIServices/bin/Debug/net10.0/WeatherFoundryConsole.dll",
            "args": [],
            "cwd": "${workspaceFolder}/FoundryConsoleV2ModelDirectNewUnifiedAIServices",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Foundry Console V3 Inject Functions",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build foundry console v3",
            "program": "${workspaceFolder}/FoundryConsoleV3InjectFunctions/bin/Debug/net10.0/WeatherFoundryConsole.dll",
            "args": [],
            "cwd": "${workspaceFolder}/FoundryConsoleV3InjectFunctions",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Foundry Console V4 MCP",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build foundry console v4",
            "program": "${workspaceFolder}/FoundryConsoleV4MCP/bin/Debug/net10.0/WeatherFoundryConsole.dll",
            "args": [],
            "cwd": "${workspaceFolder}/FoundryConsoleV4MCP",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}