{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Run All",
            "presentation": {
				"group": "maingroup",
				"order": 1
			},
            "configurations": [
                "WeatherAPI",
                "WeatherBlazor",
                "WeatherMVC",
                "React"
            ]
        }
    ],
    "configurations": [
        {
            "name": "WeatherAPI",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build weatherapi",
            "program": "${workspaceFolder}/api-dotnet/api/bin/Debug/net10.0/WeatherAPI.dll",
            "args": [],
            "cwd": "${workspaceFolder}/api-dotnet/api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/About"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "WeatherBlazor",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build weatherblazor",
            "program": "${workspaceFolder}/ui-blazor/blazor/bin/Debug/net10.0/WeatherBlazor.dll",
            "args": [],
            "cwd": "${workspaceFolder}/ui-blazor/blazor",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "WeatherMVC",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build weathermvc",
            "program": "${workspaceFolder}/mvc-dotnet/mvc/bin/Debug/net10.0/WeatherMVC.dll",
            "args": [],
            "cwd": "${workspaceFolder}/mvc-dotnet/mvc",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/mvc-dotnet/mvc/Views"
            }
        },
        {
            "name": "React",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm start",
            "cwd": "${workspaceFolder}/ui-react",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Local:\\s+https?://localhost:(\\d+)",
                "uriFormat": "http://localhost:%s"
            }
        },
        {
            "name": "WeatherMcpDotNet",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build mcp dotnet",
            "program": "${workspaceFolder}/mcp-dotnet/mcp/bin/Debug/net10.0/WeatherMcpDotNet.dll",
            "args": [],
            "cwd": "${workspaceFolder}/mcp-dotnet/mcp",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/About"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "WeatherMcpFunction",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:azureFunctions.pickProcess}"
        },
        {
            "name": "Foundry Console V1 Model Direct Legacy Cognitive Services Endpoint",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build foundry console v1",
            "program": "${workspaceFolder}/FoundryConsoleV1/bin/Debug/net10.0/FoundryConsoleV1ModelDirectLegacy.dll",
            "args": [],
            "cwd": "${workspaceFolder}/FoundryConsoleV1",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Foundry Console V2 Model Direct New Unified AI Services",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build foundry console v2",
            "program": "${workspaceFolder}/FoundryConsoleV2/bin/Debug/net10.0/FoundryConsoleV2ModelDirectUnifiedAI.dll",
            "args": [],
            "cwd": "${workspaceFolder}/FoundryConsoleV2",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Foundry Console V3 In Process Tool Callbacks",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build foundry console v3",
            "program": "${workspaceFolder}/FoundryConsoleV3/bin/Debug/net10.0/FoundryConsoleV3InProcessToolCallbacks.dll",
            "args": [],
            "cwd": "${workspaceFolder}/FoundryConsoleV3",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Foundry Console V4 Model Direct (MCP tools)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build foundry console v4",
            "program": "${workspaceFolder}/FoundryConsoleV4/bin/Debug/net10.0/FoundryConsoleV4MCP.dll",
            "args": [],
            "cwd": "${workspaceFolder}/FoundryConsoleV4",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Foundry Console V5 Agent (user prompt only)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build foundry console v5",
            "program": "${workspaceFolder}/FoundryConsoleV5/bin/Debug/net10.0/FoundryConsoleV5Agent.dll",
            "args": [],
            "cwd": "${workspaceFolder}/FoundryConsoleV5",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}