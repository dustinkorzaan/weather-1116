# Copy this file to .env and fill in your values.
# Loaded at startup via DotNetEnv (Env.TraversePath().Load()).
# Never commit your actual .env — it is listed in .gitignore.

# Azure AI Foundry project URL (required)
# Azure portal → your Azure AI Foundry project → Overview → Project endpoint.
# AZURE_FOUNDRY_PROD_EUS2_PROJ_URL=[REDACTED]
AZURE_FOUNDRY_PROD_EUS2_PROJ_URL=

# Azure AI Foundry API key (required)
# Azure portal → your Azure AI Foundry / OpenAI resource → Keys and Endpoint.
AZURE_FOUNDRY_PROD_EUS2_KEY=

# Model deployment name (required)
# AZURE_FOUNDRY_PROD_EUS2_MODEL=gpt-5.4-mini
AZURE_FOUNDRY_PROD_EUS2_MODEL=
