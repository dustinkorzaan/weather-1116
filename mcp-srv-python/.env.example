# Copy this file to .env and fill in your values.
# Loaded at startup via python-dotenv.
# Never commit your actual .env -- it is listed in .gitignore.

# Host/port for the MCP HTTP server
# MCP_SRV_PYTHON_HOST=0.0.0.0
# MCP_SRV_PYTHON_PORT=8140

# Bearer token required for /mcp (clients send Authorization: Bearer <key>)
MCP_SRV_PYTHON_KEY=dev-mcp-srv-python-key
