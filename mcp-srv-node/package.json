{
  "name": "weather-mcp-srv-node",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Node.js MCP server exposing public weather forecast and history tools backed by Open-Meteo.",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node mcp/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
