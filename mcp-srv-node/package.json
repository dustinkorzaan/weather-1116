  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
