# Root .gitignore

# OS
.DS_Store
Thumbs.db

# IDE
# .vscode/
.idea/
*.swp
*.swo
*~

# Visual Studio (solution-root cache: .vs/Weather/v18/.suo, DocumentLayout.json, FileContentIndex)
.vs/
*.user
*.suo
*.rsuser
*.userosscache
*.sln.docstates

# Dependencies
node_modules/
*.lock

# Build outputs
dist/
build/
bin/
obj/

# Environment
.env
.env.local

# Bicep compile output (source of truth is *.bicep; azd compiles at deploy time)
infra/main.json
infra/modules/*.json
