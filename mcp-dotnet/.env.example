# Copy this file to .env and fill in your values.
# Loaded at startup via DotNetEnv (Env.TraversePath().Load()).
# ASP.NET Core nested keys use double-underscore (__).
# Never commit your actual .env — it is listed in .gitignore.

# Hosting (optional — launchSettings.json sets Development + http://localhost:8110)
# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://localhost:8110

# Bearer token required for /mcp (clients send Authorization: Bearer <key>)
# MCP_API_KEY=dev-mcp-dotnet-key

# BUILD_NUMBER=
# BUILD_START=
