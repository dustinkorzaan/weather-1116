<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Homegrown mediator-pattern implementation. Must never depend on the real
         MediatR NuGet package (github.com/jbogard/MediatR) — do not add a
         PackageReference to it. -->
    <RootNamespace>CQMediator</RootNamespace>
    <AssemblyName>CQMediator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

</Project>
